{
 "about": "Golden vectors for core/allocation.py (PA6): the class AMFI's section header gives a fund, and the bars of a tab's value by class, sector, cap size, account, member and tag. Inputs are the contract's JSON (a HoldingRow's asset, price and lines, the accounts and the members), so the phone can run the same file. Every number is worked out by hand in the case's why; the evaluator in make_pa6.py builds the groups again from scratch.",
 "mf_classes": [
  {
   "id": "MF1",
   "title": "An equity scheme is MF equity",
   "why": "The words before the dash inside the brackets are the scheme's headline: Equity Scheme.",
   "header": "Open Ended Schemes(Equity Scheme - Large Cap Fund)",
   "expect": "mf_equity"
  },
  {
   "id": "MF2",
   "title": "A tax-saving fund is an equity scheme too",
   "why": "Close ended or open ended makes no difference; the headline is Equity Scheme.",
   "header": "Close Ended Schemes(Equity Scheme - ELSS)",
   "expect": "mf_equity"
  },
  {
   "id": "MF3",
   "title": "A debt scheme is MF debt",
   "why": "The words before the dash inside the brackets are Debt Scheme, the headline of a debt fund.",
   "header": "Open Ended Schemes(Debt Scheme - Liquid Fund)",
   "expect": "mf_debt"
  },
  {
   "id": "MF4",
   "title": "A hybrid scheme is MF hybrid",
   "why": "The words before the dash inside the brackets are Hybrid Scheme, the headline of a hybrid fund.",
   "header": "Open Ended Schemes(Hybrid Scheme - Aggressive Hybrid Fund)",
   "expect": "mf_hybrid"
  },
  {
   "id": "MF5",
   "title": "A solution oriented scheme is MF other",
   "why": "The headline is Solution Oriented Scheme: not equity, debt or hybrid.",
   "header": "Open Ended Schemes(Solution Oriented Scheme - Retirement Fund)",
   "expect": "mf_other"
  },
  {
   "id": "MF6",
   "title": "An index fund is MF other, whatever it follows",
   "why": "The headline is Other Scheme. What the index holds is not in the header, so no guess is made; the owner can set the class of the fund.",
   "header": "Open Ended Schemes(Other Scheme - Index Funds)",
   "expect": "mf_other"
  },
  {
   "id": "MF7",
   "title": "Case and spaces do not matter",
   "why": "'equity   scheme' with extra spaces and capitals, and no space after the dash.",
   "header": "open ended schemes( EQUITY   Scheme -Large Cap Fund )",
   "expect": "mf_equity"
  },
  {
   "id": "MF8",
   "title": "Brackets inside the brackets",
   "why": "The headline is taken from the outermost brackets: Equity Scheme, with a bracket of its own further on.",
   "header": "Open Ended Schemes(Equity Scheme - Sectoral/Thematic (Banking))",
   "expect": "mf_equity"
  },
  {
   "id": "MF9",
   "title": "A header without a dash is MF other",
   "why": "Close Ended Schemes(Income): Income is not a headline we know.",
   "header": "Close Ended Schemes(Income)",
   "expect": "mf_other"
  },
  {
   "id": "MF10",
   "title": "A header without brackets is MF other",
   "why": "There are no brackets to read a headline from, so the fund is not put in a class it may not belong to.",
   "header": "Mutual fund",
   "expect": "mf_other"
  },
  {
   "id": "MF11",
   "title": "An empty header is MF other",
   "why": "A fund whose section header is not known (empty text) has no headline to read.",
   "header": "",
   "expect": "mf_other"
  },
  {
   "id": "MF12",
   "title": "No header at all is MF other",
   "why": "A fund with no header (null) has no headline to read either; this must not be an error.",
   "header": null,
   "expect": "mf_other"
  },
  {
   "id": "MF13",
   "title": "A bracket that is never closed is MF other",
   "why": "The headline is read from between the brackets; with no closing bracket there is nothing between them, and the words after the opening one are not taken for it.",
   "header": "Open Ended Schemes(Equity Scheme - Large Cap Fund",
   "expect": "mf_other"
  },
  {
   "id": "MF14",
   "title": "Only the first dash ends the headline",
   "why": "The headline is what comes before the first dash inside the brackets: Equity Scheme. A second dash further on (Large - Mid) is part of the fund's own description and changes nothing.",
   "header": "Open Ended Schemes(Equity Scheme - Large - Mid Cap Fund)",
   "expect": "mf_equity"
  }
