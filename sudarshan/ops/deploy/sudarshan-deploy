# The downloads take time, so the market gate is asked once more right before the stop: if the
# window opened meanwhile, the install waits as it would have at the first gate.
if market_open && [[ ${FORCE} -eq 0 ]]; then
    log "release ${tag} waiting for market close (the window opened during the download)"
    rm -f -- "${bdir}/prev_ref"; rmdir -- "${bdir}" 2>/dev/null || true
    exit 0
fi
# The calendar list this release brings may make today a trading day (a special session for today,
# or today's holiday taken back): the gate is also asked of the day files as the install would leave
# them, so such a release waits as it will once the list is in place.
if [[ -n "${cal_conf}" && ${FORCE} -eq 0 ]] && cal_preview "${cal_conf}" "${tmp}/cal-gate" \
        && ( GATE_VIEW="${tmp}/cal-gate/etc"; market_open ); then
    log "release ${tag} waiting for market close (its calendar list makes today a trading day)"
    rm -f -- "${bdir}/prev_ref"; rmdir -- "${bdir}" 2>/dev/null || true
    exit 0
fi
log "stopping ${SERVICE} for the update"
for u in $(ring_services); do systemctl stop "${u}" || true; done   # same code tree, so same window
systemctl stop "${SERVICE}"
trap 'log "unexpected error at line ${LINENO}"; rollback; exit 1' ERR
# ---- backups (SQLite online backup API, DuckDB copy while stopped, previous dist, previous ref)
for db in "${APP_DIR}"/db/*.db; do
    if [[ -f "${db}" ]]; then sqlite3 "${db}" ".backup '${bdir}/$(basename "${db}")'"; fi
done
if [[ -f "${APP_DIR}/db/historify.duckdb" ]]; then cp -a "${APP_DIR}/db/historify.duckdb" "${bdir}/"; fi
tar -czf "${bdir}/frontend-dist-prev.tar.gz" -C "${APP_DIR}/frontend" dist
chown -R "${SVC_USER}:${SVC_USER}" "${bdir}"; chmod -R go-rwx "${bdir}"
# ---- code + dist + deps + migrations
as_svc git -C "${APP_DIR}" checkout -f --detach "refs/tags/${tag}"
rm -rf "${APP_DIR}/frontend/dist"; tar -xzf "${tmp}/${ASSET}" -C "${APP_DIR}/frontend"
chown -R "${SVC_USER}:${SVC_USER}" "${APP_DIR}/frontend/dist"
as_svc "${UV[@]}"
if [[ -f "${APP_DIR}/sudarshan/requirements.txt" ]]; then
    as_svc env UV_PYTHON_DOWNLOADS=never /usr/local/bin/uv pip install --quiet --python "${APP_DIR}/.venv/bin/python" -r "${APP_DIR}/sudarshan/requirements.txt"
fi
# OpenAlgo's .env gets the settings this release lists (backed up first; a rollback puts it back)
if ! env_sync apply "${env_conf}" "${ENV_FILE}" "${tmp}/env" "${bdir}/openalgo.env"; then log "updating ${ENV_FILE} failed"; rollback; exit 1; fi
# The day files get the calendar lines this release lists (the files it changes are backed up first,
# and a rollback puts them back). A bad list or a failed write is logged; the install goes on.
if [[ -n "${cal_conf}" ]]; then
    if ! cal_sync install "${cal_conf}" "${CAL_DIR}" "${tmp}/cal" "$(cal_today)" "${bdir}"; then
        log "WARNING: calendar: the day files did not take every line of ${tag}; the install goes on"
    fi
fi
# migrate_all.py runs each migration with sys.executable, so the venv python is enough (no 'uv run').
if ! as_svc bash -c "cd '${APP_DIR}/upgrade' && '${APP_DIR}/.venv/bin/python' migrate_all.py"; then log "migrations failed"; rollback; exit 1; fi
# ---- start + health (this is our own service; TRINETRA is never touched)
systemctl start "${SERVICE}"
ok=0; code=""
for _ in $(seq 1 90); do sleep 2; code="$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:5000/ || true)"; [[ "${code}" == "200" || "${code}" == "302" ]] && { ok=1; break; }; done
if [[ ${ok} -eq 1 ]]; then
    trap - ERR
    echo "${tag}" > "${STATE}/deployed_tag"; log "deployed ${tag} OK (http ${code}); backup in ${bdir}"
    # the list this install applied, fetched whole, is the one the next runs (cal_run) apply
    if [[ -n "${cal_conf}" ]]; then cal_keep "${tag}" "${cal_conf}" || true; fi
else
    log "health check failed after start (last http ${code:-none})"; rollback; exit 1
fi
# ---- ring services: install the unit files of this release and (re)start them. A failing ring
# service is reported but never rolls back OpenAlgo (trading does not depend on them).
ring_deploy() {
    local list n f names=() changed=0 old
    list="$(curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/${OWNER_REPO}/contents/sudarshan/ops/systemd?ref=${tag}" 2>/dev/null)" || list='[]'
    mkdir -p "${tmp}/units"
    while IFS= read -r n; do
        [[ -n "${n}" ]] || continue
        f="${tmp}/units/${n}"
        if ! curl -fsSL "https://raw.githubusercontent.com/${OWNER_REPO}/${tag}/sudarshan/ops/systemd/${n}" -o "${f}"; then log "ring: download of ${n} failed - skipped"; continue; fi
        if unit_ok "${f}" "${n}"; then names+=("${n}"); else log "ring: ${n} REFUSED by the unit policy"; fi
    done < <(jq -r '.[]? | select(.type=="file") | .name | select(test("^sudarshan-[a-z0-9-]+\\.(service|timer)$"))' <<< "${list}")
    for n in "${names[@]}"; do
        if ! cmp -s "${tmp}/units/${n}" "${UNIT_DIR}/${n}"; then
            install -m 644 -o root -g root "${tmp}/units/${n}" "${UNIT_DIR}/${n}"; changed=1; log "ring: installed ${n}"
        fi
    done
    for old in $(managed_units); do   # units this tool installed before but the release dropped
        if [[ " ${names[*]} " != *" ${old} "* ]]; then
            systemctl disable --now "${old}" > /dev/null 2>&1 || true
            rm -f "${UNIT_DIR:?}/${old}"; changed=1; log "ring: removed ${old}"
        fi
    done
    [[ ${changed} -eq 1 ]] && systemctl daemon-reload
    printf '%s\n' "${names[@]}" > "${MANAGED}"
    for n in "${names[@]}"; do
        if [[ "${n}" == *.timer ]]; then
            systemctl enable --now "${n}" > /dev/null 2>&1 || log "ring: ${n} could not be enabled"
        else
            systemctl enable "${n}" > /dev/null 2>&1 || true
            systemctl restart "${n}" || log "ring: ${n} did not start"
        fi
    done
    if [[ ${#names[@]} -gt 0 ]]; then
        sleep 5
        for n in "${names[@]}"; do log "ring: ${n} $(systemctl is-active "${n}" 2>/dev/null || true)"; done
    fi
}
ring_deploy || log "WARNING: ring service step failed - OpenAlgo itself is deployed"
# keep the 10 newest backups
{ ls -1dt /opt/sudarshan/backups/*/ 2>/dev/null | tail -n +11 | xargs -r rm -rf; } || true
