#!/usr/bin/env bash
# sudarshan-deploy — bring the live OpenAlgo to the latest GitHub Release tag of the fork.
# Design (first version, deliberately simple): the code is checked out IN PLACE in APP_DIR
# (git checkout -f of the tag), frontend/dist is replaced by the CI-built release asset,
# Python deps are refreshed the same way the installer did it (uv pip -r requirements-nginx.txt),
# migrations run, openalgo restarts, health is checked. No releases/current symlink layout yet:
# the systemd unit, nginx and the venv all point at APP_DIR, and changing that would touch the
# live unit. Rollback = previous git ref + previous frontend/dist tarball + SQLite .backup copies.
# Lives in the repo at sudarshan/ops/deploy/sudarshan-deploy; every release can update it.
# Also manages the SUDARSHAN ring services: unit files under sudarshan/ops/systemd at the tag
# (sudarshan-*.service / .timer) are fetched from GitHub, checked against a strict policy (never
# root, no privileged exec prefixes, capabilities or realtime scheduling), installed and restarted.
# And OpenAlgo's .env gets the settings the release lists in sudarshan/ops/deploy/openalgo-env.conf
# (added when missing, replaced only while they hold a default an earlier release shipped).
# And the NSE day files in /etc/sudarshan get the calendar lines the release lists in
# sudarshan/ops/deploy/nse-calendar.conf, on every run, also when nothing is installed and in market
# hours (a shipped date is added when missing; only a line an earlier release shipped is replaced,
# and nothing that could open the market gate on the day changes outside an install).
# Usage: sudarshan-deploy [--check | --redeploy | --force]
#   --check     show latest Release / deployed tag / market state and the .env settings and
#               calendar lines that release would change, change nothing
#   --redeploy  install the latest Release again even if it is already deployed (still gated)
#   --force     like --redeploy but ALSO ignores the market-hours gate (root only, emergencies)
set -Eeuo pipefail
MODE="deploy"; FORCE=0; REDEPLOY=0
case "${1:-}" in
    --check) MODE="check" ;;
    --redeploy) REDEPLOY=1 ;;
    --force) FORCE=1; REDEPLOY=1 ;;
    "") ;;
    *) echo "usage: sudarshan-deploy [--check|--redeploy|--force]" >&2; exit 2 ;;
esac
# shellcheck disable=SC1091
source /etc/sudarshan/deploy.env
STATE="/var/lib/sudarshan"; mkdir -p "${STATE}"
exec 9> "${STATE}/deploy.lock"; flock -n 9 || { echo "another deploy is running"; exit 0; }
OWNER_REPO="${REPO#https://github.com/}"
as_svc() { sudo -u "${SVC_USER}" -H -- "$@"; }
log() { echo "[$(date '+%F %T %Z')] $*"; }
listed() {   # 0 = date $1 starts a line of file $2 (a trailing comment is allowed, as auto-login reads
             # it). Only a regular file is read: grep would wait forever on a FIFO.
    # As autologin/schedule.py reads it: ASCII spaces (C locale), NUL inside a line (-a), a BOM.
    local bom=$'\xef\xbb\xbf'
    [[ -f "$2" ]] && LC_ALL=C grep -aqE "^(${bom})?[[:space:]]*${1}([[:space:]#]|$)" "$2" 2>/dev/null
}
day_trading() {   # $1 = date, $2 = ISO weekday, $3 = HHMM, $4 = holiday file, $5 = extra-days file;
                  # 0 = within trading hours by those files
    # A special session (a weekend or holiday session the exchange announces, such as Muhurat
    # trading) keeps its own hours, so nothing is restarted at any time that day.
    listed "$1" "$5" && return 0
    [[ "$2" -ge 6 ]] && return 1
    listed "$1" "$4" && return 1
    # 10# forces decimal: "0930" would otherwise be read as an invalid octal number
    local t=$((10#$3))
    (( t >= 900 && t <= 1545 ))
}
market_open() {   # 0 = trading hours (do not restart), 1 = safe. Trading when the day files say so as
                  # they are, or as they stood before this run's calendar step (GATE_VIEW, kept by
                  # gate_view): that step can make a day a trading day, never take one away.
    local now dow hhmm today
    now="$(TZ=Asia/Kolkata date '+%u %H%M %F')"; read -r dow hhmm today <<< "${now}"
    if [[ -n "${GATE_VIEW:-}" ]] && day_trading "${today}" "${dow}" "${hhmm}" \
            "${GATE_VIEW}/nse_holidays.txt" "${GATE_VIEW}/nse_extra_trading_days.txt"; then
        return 0
    fi
    day_trading "${today}" "${dow}" "${hhmm}" /etc/sudarshan/nse_holidays.txt /etc/sudarshan/nse_extra_trading_days.txt
}
# ---- OpenAlgo .env settings a release needs: sudarshan/ops/deploy/openalgo-env.conf, whose header
# gives the format. Read from GitHub at the release tag, like this tool and the unit files. A key is
# added when missing and replaced only while it holds an old value listed for it, so a value the
# owner chose stays. .env holds secrets: nothing from it is printed, only managed key names and
# the values the release sets. Root works on a private copy and moves the result into place, so a
# symlink planted in APP_DIR or in the backup folder is never followed.
ENV_FILE="${APP_DIR}/.env"
FETCH_TIMEOUT=60   # seconds one list from GitHub may take
release_file() {   # $1 = file in sudarshan/ops/deploy, $2 = tag, $3 = output. 0 = fetched whole, with a 200
                   # (an empty file is an empty list); 3 = the release has no such file (404: $3 is left
                   # empty); 1 = not fetched: no answer, an error, or a body cut off in transit (curl then
                   # fails although it saw 200) or not ending in a newline
    local code
    code="$(curl -sSL --max-time "${FETCH_TIMEOUT}" -o "$3" -w '%{http_code}' "https://raw.githubusercontent.com/${OWNER_REPO}/$2/sudarshan/ops/deploy/$1" 2>/dev/null)" || return 1
    case "${code}" in
        200) [[ ! -s "$3" || "$(tail -c 1 -- "$3"; printf x)" == $'\nx' ]] ;;
        404) : > "$3"; return 3 ;;
        *) return 1 ;;
    esac
}
env_conf_fetch() { release_file openalgo-env.conf "$1" "$2" || [[ $? -eq 3 ]]; }   # $1 = tag, $2 = output;
                                                                                    # no list: an empty one
env_sync() {   # $1 = check|apply, $2 = settings list, $3 = .env, $4 = private work dir (root only),
               # $5 = backup to write (apply). 0 = done or nothing to do, 1 = bad list or I/O error.
    local mode="$1" conf="$2" env="$3" work="$4" backup="${5:-}"
    local LC_ALL=C   # bytes, not characters: in a UTF-8 locale a stray byte hides a line from =~
    local orig="$4/env.orig" new="$4/env.new" q="'" eol=$'\n' line k v pre n=0 prev=0 spans=0
    local re_key='^[A-Za-z_][A-Za-z0-9_]*$' re_word='^[A-Za-z0-9._:/@+,-]+$'
    local re_bind='^([[:space:]]*(export[[:space:]]+)?)([^=#[:space:]]+)([[:space:]]*=[[:space:]]*)(.*)$'
    local re_qkey="^[${q}\"](.*)[${q}\"]\$"
    local re_sq="^${q}([^${q}\\]*)${q}([[:space:]]*(#.*)?)\$"   # 'value' # comment
    local re_dq='^"([^"\$]*)"([[:space:]]*(#.*)?)$'            # "value" # comment
    local re_uq="^([^[:space:]${q}\"][^[:space:]]*)?(([[:space:]]+#.*)?[[:space:]]*)\$"
    local w_add="added" w_set="set"
    local -a words=() keys=() add=() changed_keys=() repl=()
    local -A want=() olds=() count=() line_of=() cur=() lead=() post=() odd=()
    if [[ "${mode}" == "check" ]]; then w_add="would add"; w_set="would set"; fi
    [[ -f "${conf}" && -r "${conf}" ]] || { log "settings: the list ${conf} is missing"; return 1; }
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        read -r -a words <<< "${line%%#*}"
        [[ ${#words[@]} -gt 0 ]] || continue
        k="${words[0]}"
        if [[ ${#words[@]} -lt 2 || ! "${k}" =~ ${re_key} || -n "${want[${k}]+set}" ]]; then
            log "settings: list line ${n} is not a new KEY followed by VALUE and OLD values"; return 1
        fi
        olds[${k}]="|"
        for v in "${words[@]:1}"; do
            if [[ "${v}" == "''" ]]; then v=""; elif [[ ! "${v}" =~ ${re_word} ]]; then
                log "settings: list line ${n} has a value with a character the list does not allow"; return 1
            fi
            if [[ -z "${want[${k}]+set}" ]]; then want[${k}]="${v}"; else olds[${k}]+="${v}|"; fi
        done
        keys+=("${k}")
    done < "${conf}"
    rm -rf -- "${orig}" "${new}"
    if [[ ! -e "${env}" && ! -L "${env}" ]]; then log "settings: there is no ${env}, so nothing is changed"; return 0; fi
    # cp -a never follows a symlink (it opens the source with O_NOFOLLOW) and never reads a FIFO
    if ! cp -a -- "${env}" "${orig}" 2>/dev/null || [[ -L "${orig}" || ! -f "${orig}" ]]; then
        rm -rf -- "${orig}"; log "WARNING: settings: ${env} is not a plain file, so it is left alone"; return 0
    fi
    if [[ "${mode}" == "apply" ]] && ! { cp -a -- "${orig}" "${work}/env.backup" && chmod 600 "${work}/env.backup" \
            && mv -fT -- "${work}/env.backup" "${backup}"; }; then
        log "settings: could not back up ${env}"; return 1
    fi
    n=0
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        [[ "${line}" =~ ${re_bind} ]] || continue
        pre="${BASH_REMATCH[1]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"; k="${BASH_REMATCH[3]}"; v="${BASH_REMATCH[5]}"
        if [[ "${k}" =~ ${re_qkey} ]]; then k="${BASH_REMATCH[1]}"; fi   # python-dotenv reads 'KEY'=
        case "${v}" in   # a quote not closed on its line runs on: this line-by-line edit stays away
            \'*) [[ "${v:1}" == *\'* ]] || spans=1 ;;
            \"*) [[ "${v:1}" == *\"* ]] || spans=1 ;;
        esac
        [[ -n "${want[${k}]+set}" ]] || continue
        count[${k}]=$(( ${count[${k}]:-0} + 1 )); line_of[${k}]=${n}; lead[${k}]="${pre}"
        if [[ "${v}" =~ ${re_sq} || "${v}" =~ ${re_dq} || "${v}" =~ ${re_uq} ]]; then
            cur[${k}]="${BASH_REMATCH[1]}"; post[${k}]="${BASH_REMATCH[2]}"
        else
            odd[${k}]=1
        fi
    done < "${orig}"
    if [[ "${mode}" == "check" ]]; then rm -f -- "${orig}"; fi   # a copy of secrets kept no longer than needed
    if [[ ${spans} -eq 1 ]]; then
        log "WARNING: settings: ${env} has a value running over several lines, so it is left alone"; return 0
    fi
    for k in "${keys[@]}"; do
        v="${want[${k}]}"
        if [[ -z "${count[${k}]:-}" ]]; then
            add+=("${k}"); changed_keys+=("${k}"); log "settings: ${w_add} ${k}='${v}'"
        elif [[ ${count[${k}]} -gt 1 ]]; then
            log "settings: ${k} left alone: .env sets it ${count[${k}]} times"
        elif [[ -n "${odd[${k}]:-}" ]]; then
            log "settings: ${k} left alone: its line is in a form this tool does not rewrite"
        elif [[ "${cur[${k}]}" == "${v}" ]]; then
            :
        elif [[ "${olds[${k}]}" == *"|${cur[${k}]}|"* ]]; then   # the guard: only a shipped default
            repl[${line_of[${k}]}]="${lead[${k}]}'${v}'${post[${k}]}"; changed_keys+=("${k}")
            log "settings: ${w_set} ${k}='${v}' in place of a default an earlier release shipped"
        else
            log "settings: ${k} left alone: the owner chose its value"
        fi
    done
    [[ ${#changed_keys[@]} -gt 0 ]] || { log "settings: nothing to change in ${env}"; return 0; }
    [[ "${mode}" == "apply" ]] || return 0
    if grep -q $'\r$' "${orig}"; then eol=$'\r\n'; fi
    # The copy keeps owner, group, mode and ACLs; only the listed lines are rewritten, every other
    # byte comes from sed/tail, and the result replaces .env in one rename.
    { cp -a -- "${orig}" "${new}" && : > "${new}"; } || { log "settings: could not write ${new}"; return 1; }
    for n in "${!repl[@]}"; do
        if [[ ${n} -gt $((prev + 1)) ]]; then sed -n "$((prev + 1)),$((n - 1))p" "${orig}" >> "${new}" || return 1; fi
        printf '%s\n' "${repl[${n}]}" >> "${new}" || return 1
        prev=${n}
    done
    tail -n "+$((prev + 1))" "${orig}" >> "${new}" || return 1
    if [[ ${#add[@]} -gt 0 && -s "${new}" && -n "$(tail -c 1 "${new}")" ]]; then printf '%s' "${eol}" >> "${new}" || return 1; fi
    for k in "${add[@]}"; do printf "%s='%s'%s" "${k}" "${want[${k}]}" "${eol}" >> "${new}" || return 1; done
    mv -fT -- "${new}" "${env}" || { log "settings: could not replace ${env}"; return 1; }
    log "settings: ${env} updated (${changed_keys[*]}); the previous one is in ${backup}"
}
env_restore() {   # $1 = env_sync's work dir, $2 = .env: put back the copy env_sync took before any change
    [[ -f "$1/env.orig" ]] || return 0   # this deploy never read .env, so it never changed it
    cp -a -- "$1/env.orig" "$1/env.restore" && mv -fT -- "$1/env.restore" "$2" || return 1
    log "settings: ${2} put back as it was before the deploy"
}
# ---- NSE calendar lines a release ships: sudarshan/ops/deploy/nse-calendar.conf, whose header gives
# the format, merged into the day files the market gate above, auto-login and the order alerts read.
# They read a changed file again by themselves, so every run applies the list of the installed release
# (cal_run) and an install the list of the release it brings (backed up, put back on a rollback).
# A missing shipped date is added; a line is replaced only while it is a version a release shipped
# for that date, and dropped only when this tool added it; a line the owner wrote stays, and a line
# he took out stays out. A run that installs nothing changes no line dated today or earlier (except
# that it adds a special session for today) and never decides its own market gate. A holiday is never
# added on or after its day, and an install whose list would make today a trading day waits
# (cal_preview). Notes are logged once while they hold, changes once written. A failure is logged and
# never stops an install or a rollback.
CAL_DIR="/etc/sudarshan"
# A day file the list creates gets the owner and mode of the other files there (sudarshan/README.md).
CAL_OWNER="root:${SVC_USER}"; CAL_MODE=640
CAL_RECORD="${STATE}/calendar_applied"   # each line this tool put in a day file and has not dropped
CAL_NOTES="${STATE}/calendar_notes"      # the notes logged so far, each once while it holds
CAL_LISTS="${STATE}/calendar-lists"      # the installed release's list, once fetched whole
GATE_VIEW=""                             # the day files as this run found them (gate_view)
cal_conf_fetch() { release_file nse-calendar.conf "$1" "$2"; }   # $1 = tag, $2 = output
cal_today() {   # today's date in IST, from the clock the market gate reads
    local now
    now="$(TZ=Asia/Kolkata date '+%u %H%M %F')" && printf '%s\n' "${now##* }"
}
cal_day_ok() {   # 0 = $1 is a date that exists, written YYYY-MM-DD (the form the market gate matches)
    local y m d last=31
    [[ "$1" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]] || return 1
    y=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]})); d=$((10#${BASH_REMATCH[3]}))
    case "${m}" in
        4|6|9|11) last=30 ;;
        2) last=28; if (( y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) )); then last=29; fi ;;
    esac
    (( y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= last ))
}
cal_dir_ok() {   # 0 = $1 is a real folder owned by the user this tool runs as, writable by no one else
    local st
    [[ -d "$1" && ! -L "$1" ]] && st="$(stat -c '%u %a' -- "$1")" || return 1
    [[ "${st% *}" == "${EUID}" ]] && (( (8#${st#* } & 8#022) == 0 ))
}
cal_held() {   # $1 = check|run|install, $2 = today, $3 = file, $4 = date, $5 = add|replace|drop.
               # 0, with the reason on stdout, when that change must not be made now; 1 when it may
    if [[ "$3" == "nse_holidays.txt" && "$5" == "add" && ! "$4" > "$2" ]]; then
        echo "not added: a holiday is added only before its day"; return 0
    fi
    if [[ "$1" == "run" && ! "$4" > "$2" ]] \
            && [[ "$3" != "nse_extra_trading_days.txt" || "$5" != "add" || "$4" != "$2" ]]; then
        echo "kept as it is: a run that installs nothing changes no line dated today or earlier (an install does)"
        return 0
    fi
    return 1
}
cal_note() {   # $1 = a note: logged once while it holds (cal_flush keeps the notes that do)
    if [[ -f "${CAL_NOTES}" ]] && grep -qxF -- "$1" "${CAL_NOTES}"; then return 0; fi
    log "$1"; printf '%s\n' "$1" 2>/dev/null >> "${CAL_NOTES}" || true
}
cal_flush() {   # $1 = check|run|install, then the notes of one cal_sync. check logs them all; else
                # each is logged once while it holds, and the notes kept are the ones that hold now.
    local mode="$1" w
    local -A had=()
    shift
    if [[ "${mode}" == "check" ]]; then for w in "$@"; do log "${w}"; done; return 0; fi
    if [[ -f "${CAL_NOTES}" ]]; then while IFS= read -r w; do if [[ -n "${w}" ]]; then had[${w}]=1; fi; done < "${CAL_NOTES}"; fi
    for w in "$@"; do if [[ -z "${had[${w}]+set}" ]]; then log "${w}"; fi; done
    { if [[ $# -gt 0 ]]; then printf '%s\n' "$@"; fi; } 2>/dev/null > "${CAL_NOTES}.new" && mv -fT -- "${CAL_NOTES}.new" "${CAL_NOTES}" 2>/dev/null
}
cal_sync() {   # $1 = check|run|install, $2 = calendar list, $3 = folder of the day files, $4 = private
               # work dir (root only), $5 = today (YYYY-MM-DD, IST), $6 = the install's backup folder:
               # a file the install changes is copied there first and kept in $4 for cal_restore.
               # run: every run (see cal_held); check: as install, writing nothing.
               # 0 = done or nothing to do, 1 = a bad list or a file not written.
    local mode="$1" conf="$2" dir="$3" work="$4" today="$5" backup="${6:-}"
    local LC_ALL=C   # bytes, not characters, as in env_sync
    local t=$'\t' cr=$'\r' nl=$'\n' line kw text day key name="" re form bad="" why n=0 k=-1 i r w
    local path snap tmpf eol prev ok exists present ours bare rc=0 told=0 recnew=0
    local grow="added" swap="replaced" cut="removed"
    local re_skip='^[[:space:]]*(#|$)' re_file='^[[:blank:]]*\[([^]]*)\][[:space:]]*$'
    local re_kw='^[[:blank:]]*(line|was|drop)[[:blank:]]+(.*[^[:space:]])[[:space:]]*$'
    local re_hol="^([0-9]{4}-[0-9]{2}-[0-9]{2})([ ${t}]+#[ -~${t}]*)?\$"
    local re_xtra="^([0-9]{4}-[0-9]{2}-[0-9]{2})([ ${t}]+([0-9]{2}):([0-9]{2})-([0-9]{2}):([0-9]{2}))?([ ${t}]+#[ -~${t}]*)?\$"
    local -a names=() e_file=() e_kind=() e_text=() e_day=() e_olds=() sec=() lines=() trim=() lday=()
    local -a oldof=() dropof=() done_=() repl=() gone=() edit=() adds=() found=() owners=() notes=()
    local -a said=() tally=()
    local -A files=() days=() texts=() rec=()
    if [[ "${mode}" == "check" ]]; then grow="would add"; swap="would replace"; cut="would remove"; fi
    [[ -f "${conf}" && -r "${conf}" ]] || { log "calendar: the list ${conf} is missing"; return 1; }
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        if [[ "${line}" =~ ${re_skip} ]]; then
            continue
        elif [[ "${line}" =~ ${re_file} ]]; then
            name="${BASH_REMATCH[1]}"; k=-1
            if [[ "${name}" != "nse_holidays.txt" && "${name}" != "nse_extra_trading_days.txt" ]]; then
                bad="list line ${n} names a file other than nse_holidays.txt and nse_extra_trading_days.txt"; break
            elif [[ -n "${files[${name}]+set}" ]]; then
                bad="list line ${n} names ${name} a second time"; break
            fi
            files[${name}]=1; names+=("${name}"); continue
        elif [[ ! "${line}" =~ ${re_kw} ]]; then
            bad="list line ${n} is not a [FILE], line, was or drop line"; break
        fi
        kw="${BASH_REMATCH[1]}"; text="${BASH_REMATCH[2]}"
        if [[ -z "${name}" ]]; then bad="list line ${n} comes before the first [FILE] line"; break; fi
        if [[ "${name}" == "nse_holidays.txt" ]]; then re="${re_hol}"; form="YYYY-MM-DD"
        else re="${re_xtra}"; form="YYYY-MM-DD, an optional HH:MM-HH:MM window"; fi
        if [[ ! "${text}" =~ ${re} ]]; then
            bad="list line ${n} is not ${form} and an optional # comment, in plain ASCII"; break
        fi
        day="${BASH_REMATCH[1]}"
        if [[ -n "${BASH_REMATCH[3]:-}" ]] && ! (( 10#${BASH_REMATCH[3]} < 24 && 10#${BASH_REMATCH[4]} < 60
                && 10#${BASH_REMATCH[5]} < 24 && 10#${BASH_REMATCH[6]} < 60 && 10#${BASH_REMATCH[3]} * 60
                + 10#${BASH_REMATCH[4]} < 10#${BASH_REMATCH[5]} * 60 + 10#${BASH_REMATCH[6]} )); then
            bad="list line ${n} has a window that is not HH:MM-HH:MM with the start before the end"; break
        fi
        if ! cal_day_ok "${day}"; then bad="list line ${n} has a date that does not exist"; break; fi
        key="${name}|${text}"
        if [[ -n "${texts[${key}]+set}" ]]; then bad="list line ${n} repeats a line of ${name}"; break; fi
        texts[${key}]=${n}
        if [[ "${kw}" == "was" ]]; then
            if [[ ${k} -lt 0 ]]; then bad="list line ${n} is a was with no line above it"; break; fi
            if [[ "${day}" != "${e_day[k]}" ]]; then bad="list line ${n} is a was for another date than its line"; break; fi
            e_olds[k]+="${text}${nl}"; continue
        fi
        if [[ "${kw}" == "line" ]]; then
            if [[ -n "${days[${name}/${day}]+set}" ]]; then bad="list line ${n} is a second line for ${day}"; break; fi
            days[${name}/${day}]=1
        fi
        k=${#e_text[@]}; e_file+=("${name}"); e_kind+=("${kw}"); e_text+=("${text}"); e_day+=("${day}"); e_olds+=("")
        if [[ "${kw}" == "drop" ]]; then k=-1; fi   # a was belongs to a line
    done < "${conf}"
    if [[ -n "${bad}" ]]; then cal_flush "${mode}" "calendar: ${bad}"; return 1; fi
    if [[ ${#e_text[@]} -eq 0 ]]; then   # a release without calendar lines
        cal_flush "${mode}" || true
        if [[ "${mode}" != "run" ]]; then log "calendar: nothing to change in ${dir}"; fi
        return 0
    fi
    if [[ ! "${today}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        cal_flush "${mode}" "calendar: the date today is not known, so the day files are left alone"; return 1
    fi
    if ! cal_dir_ok "${dir}"; then
        notes+=("calendar: ${dir} is not a folder owned by root and closed to others, so the day files are left alone")
        if [[ "${mode}" != "check" ]]; then cal_flush "${mode}" "${notes[@]}"; return 1; fi
    elif [[ "${mode}" != "check" ]]; then
        while IFS= read -r -d '' w; do   # a temporary file a killed run left behind
            if rm -f -- "${w}"; then log "calendar: removed ${w}, left by an interrupted run"; fi
        done < <(find "${dir}" -maxdepth 1 -type f \( -name '.nse_holidays.txt.??????' \
            -o -name '.nse_extra_trading_days.txt.??????' \) -mmin +10 -print0 2>/dev/null)
    fi
    if [[ -f "${CAL_RECORD}" ]]; then while IFS= read -r w; do if [[ -n "${w}" ]]; then rec[${w}]=1; fi; done < "${CAL_RECORD}"; fi
    for name in "${names[@]}"; do
        path="${dir}/${name}"; snap="${work}/${name}.snap"; exists=0
        sec=(); lines=(); trim=(); lday=(); oldof=(); dropof=(); done_=(); repl=(); gone=(); edit=()
        adds=(); said=(); tally=()
        for k in "${!e_file[@]}"; do if [[ "${e_file[k]}" == "${name}" ]]; then sec+=("${k}"); fi; done
        [[ ${#sec[@]} -gt 0 ]] || continue
        if [[ -L "${path}" ]] || [[ -e "${path}" && ! -f "${path}" ]]; then
            notes+=("WARNING: calendar: ${path} is not a plain file, so it is left alone"); continue
        elif [[ -e "${path}" ]]; then   # read from a private copy (cp -a never follows a symlink)
            if ! { rm -f -- "${snap}" && cp -a -- "${path}" "${snap}" && mapfile -t lines < "${snap}"; } 2>/dev/null; then
                notes+=("calendar: could not read ${path}, so it is left as it was"); rc=1; continue
            fi
            exists=1
        fi
        for i in "${!lines[@]}"; do   # each line as the readers see it: its text and the date it lists
            line="${lines[i]}"; trim[i]="${line%"${line##*[![:space:]]}"}"
            line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; lday[i]="${line%%[[:space:]]*}"
            [[ -n "${trim[i]}" ]] || continue
            for k in "${sec[@]}"; do
                if [[ "${e_kind[k]}" == "drop" ]]; then
                    if [[ "${trim[i]}" == "${e_text[k]}" ]]; then dropof[i]=${k}; fi
                elif [[ "${nl}${e_olds[k]}" == *"${nl}${trim[i]}${nl}"* ]]; then oldof[i]=${k}; fi
            done
        done
        # Drops, then replacements, then additions: a line a release takes out never counts as the
        # owner's, and a date a drop frees can take the new line.
        for r in 0 1 2; do
            for k in "${sec[@]}"; do
                [[ -z "${done_[k]:-}" ]] || continue
                if [[ "${e_kind[k]}" == "drop" ]]; then
                    done_[k]=1; found=()
                    for i in "${!trim[@]}"; do if [[ -z "${gone[i]:-}" && "${dropof[i]:-}" == "${k}" ]]; then found+=("${i}"); fi; done
                    if [[ ${#found[@]} -eq 0 ]]; then
                        :
                    elif [[ "${rec[${name}|${e_text[k]}]:-}" != 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: this tool did not add \"${e_text[k]}\", so the owner did (a release drops only lines it added)")
                    elif why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" drop)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        for i in "${found[@]}"; do gone[i]=1; edit[i+1]=1; done
                        said+=("calendar: ${name}: ${cut} \"${e_text[k]}\""); tally+=("-${name}|${e_text[k]}")
                    fi
                    continue
                fi
                [[ ${r} -ge 1 ]] || continue
                present=0; found=(); owners=()
                for i in "${!trim[@]}"; do
                    [[ -z "${gone[i]:-}" ]] || continue
                    if [[ "${trim[i]}" == "${e_text[k]}" ]]; then present=1
                    elif [[ "${oldof[i]:-}" == "${k}" ]]; then found+=("${i}")
                    elif [[ -z "${oldof[i]:-}" && "${lday[i]}" == "${e_day[k]}" ]]; then owners+=("${i}"); fi
                done
                if [[ ${present} -eq 1 ]]; then
                    done_[k]=1
                elif [[ ${#found[@]} -eq 1 && ${#owners[@]} -eq 0 ]]; then
                    done_[k]=1; i=${found[0]}
                    if why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" replace)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        said+=("calendar: ${name}: ${swap} \"${trim[i]}\" with \"${e_text[k]}\""); tally+=("+${name}|${e_text[k]}")
                        repl[i+1]="${e_text[k]}"; edit[i+1]=1; trim[i]="${e_text[k]}"; lday[i]="${e_day[k]}"; unset 'oldof[i]'
                    fi
                elif [[ ${r} -eq 2 ]]; then
                    done_[k]=1; ours=0
                    while IFS= read -r w; do
                        if [[ -n "${w}" && "${rec[${name}|${w}]:-}" == 1 ]]; then ours=1; fi
                    done <<< "${e_text[k]}${nl}${e_olds[k]}"
                    if [[ $(( ${#found[@]} + ${#owners[@]} )) -gt 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: the file lists it $(( ${#found[@]} + ${#owners[@]} )) times")
                    elif [[ ${#owners[@]} -eq 1 ]]; then
                        w="${trim[${owners[0]}]//[^ -~]/?}"
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: the owner wrote it as \"${w:0:100}\" (this release ships \"${e_text[k]}\")")
                    elif [[ ${ours} -eq 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} not added again: this tool added it before, and it was taken out by hand")
                    elif why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" add)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        said+=("calendar: ${name}: ${grow} \"${e_text[k]}\""); tally+=("+${name}|${e_text[k]}")
                        adds+=("${e_text[k]}"); trim+=("${e_text[k]}"); lday+=("${e_day[k]}")
                    fi
                fi
            done
        done
        [[ ${#said[@]} -gt 0 ]] || continue
        if [[ "${mode}" == "check" ]]; then
            for w in "${said[@]}"; do log "${w}"; done
            if [[ ${exists} -eq 0 ]]; then log "calendar: would create ${path} (${CAL_OWNER} ${CAL_MODE})"; fi
            told=1; continue
        fi
        if [[ "${mode}" == "install" ]]; then   # the previous file, before any change
            ok=0
            if [[ ${exists} -eq 0 ]]; then
                : > "${work}/${name}.absent" && ok=1
            elif { cp -a -- "${snap}" "${work}/${name}.orig" && cp -a -- "${snap}" "${work}/${name}.bak" \
                    && mv -fT -- "${work}/${name}.bak" "${backup}/${name}"; } 2>/dev/null; then
                ok=1
            fi
            if [[ ${ok} -eq 0 ]]; then
                rm -f -- "${work}/${name}.orig" "${work}/${name}.absent" "${work}/${name}.bak"
                notes+=("calendar: could not back up ${path}, so it is left as it was"); rc=1; continue
            fi
        fi
        # The new file gets the old one's owner, group and mode (or those of a new day file), is
        # written next to it through one descriptor and renamed over it: a reader sees the old file
        # or the new one, never half of one.
        eol="${nl}"; if [[ ${exists} -eq 1 ]] && grep -q "${cr}\$" "${snap}"; then eol="${cr}${nl}"; fi
        bare=0   # the kept text ends with no newline, so an addition starts a line of its own first
        if [[ ${exists} -eq 1 && -s "${snap}" && -z "${edit[${#lines[@]}]+set}" \
                && "$(tail -c 1 "${snap}"; printf x)" != "${nl}x" ]]; then bare=1; fi
        ok=0
        if tmpf="$(mktemp -p "${dir}" ".${name}.XXXXXX" 2>/dev/null)"; then
            ok=1
            if [[ ${exists} -eq 1 ]]; then
                { chown -h --reference="${snap}" -- "${tmpf}" && chmod --reference="${snap}" -- "${tmpf}"; } 2>/dev/null || ok=0
            else
                { chown -h -- "${CAL_OWNER}" "${tmpf}" && chmod -- "${CAL_MODE}" "${tmpf}"; } 2>/dev/null || ok=0
            fi
            if [[ ${ok} -eq 1 ]]; then
                {
                    prev=0
                    for i in "${!edit[@]}"; do   # every other byte comes from sed/tail, as in env_sync
                        if [[ ${i} -gt $((prev + 1)) ]]; then sed -n "$((prev + 1)),$((i - 1))p" "${snap}" || ok=0; fi
                        if [[ -n "${repl[i]+set}" ]]; then   # a line in gone is left out
                            w="${nl}"; if [[ "${lines[i - 1]}" == *"${cr}" ]]; then w="${cr}${nl}"; fi
                            printf '%s%s' "${repl[i]}" "${w}" || ok=0
                        fi
                        prev=${i}
                    done
                    if [[ ${exists} -eq 1 ]]; then tail -n "+$((prev + 1))" "${snap}" || ok=0; fi
                    if [[ ${bare} -eq 1 && ${#adds[@]} -gt 0 ]]; then printf '%s' "${eol}" || ok=0; fi
                    for w in "${adds[@]}"; do printf '%s%s' "${w}" "${eol}" || ok=0; done
                } 2>/dev/null > "${tmpf}" || ok=0
            fi
            if [[ ${ok} -eq 0 ]] || ! mv -fT -- "${tmpf}" "${path}" 2>/dev/null; then rm -f -- "${tmpf}"; ok=0; fi
        fi
        if [[ ${ok} -eq 0 ]]; then
            rm -f -- "${work}/${name}.orig" "${work}/${name}.absent"
            notes+=("calendar: could not write ${path}, so it is left as it was"); rc=1; continue
        fi
        for w in "${said[@]}"; do log "${w}"; done
        if [[ ${exists} -eq 0 ]]; then log "calendar: ${path} created (${CAL_OWNER} ${CAL_MODE})"
        elif [[ -n "${backup}" ]]; then log "calendar: ${path} updated; the previous one is in ${backup}/${name}"
        else log "calendar: ${path} updated"; fi
        for w in "${tally[@]}"; do   # what this tool put in that file, and took out
            if [[ "${w}" == +* ]]; then rec[${w#+}]=1; else rec[${w#-}]=0; fi
        done
        told=1; recnew=1
    done
    rm -f -- "${work}"/*.snap
    if [[ ${recnew} -eq 1 ]]; then   # an install keeps the previous record in $4 for cal_restore
        if [[ "${mode}" == "install" && ! -e "${work}/calendar_applied.orig" && ! -e "${work}/calendar_applied.absent" ]]; then
            if [[ -f "${CAL_RECORD}" ]]; then cp -a -- "${CAL_RECORD}" "${work}/calendar_applied.orig" 2>/dev/null || rc=1
            else : > "${work}/calendar_applied.absent" || rc=1; fi
        fi
        if ! { for w in "${!rec[@]}"; do if [[ "${rec[${w}]}" == 1 ]]; then printf '%s\n' "${w}"; fi; done; } 2>/dev/null > "${CAL_RECORD}.new" \
                || ! mv -fT -- "${CAL_RECORD}.new" "${CAL_RECORD}" 2>/dev/null; then
            notes+=("calendar: could not save ${CAL_RECORD}"); rc=1
        fi
    fi
    cal_flush "${mode}" "${notes[@]}" || true
    if [[ ${told} -eq 0 && ${rc} -eq 0 && "${mode}" != "run" ]]; then log "calendar: nothing to change in ${dir}"; fi
    return "${rc}"
}
cal_restore() {   # $1 = cal_sync's work dir, $2 = folder of the day files: undo what an install changed,
                  # each file renamed into place whole, as it was (owner, group, mode and time)
    local name tmpf rc=0
    for name in nse_holidays.txt nse_extra_trading_days.txt; do
        if [[ -f "$1/${name}.absent" ]]; then
            if rm -f -- "$2/${name}"; then log "calendar: $2/${name} removed: the deploy had created it"; else rc=1; fi
        elif [[ -f "$1/${name}.orig" ]]; then
            tmpf=""
            if tmpf="$(mktemp -p "$2" ".${name}.XXXXXX")" && cp -a -- "$1/${name}.orig" "${tmpf}" \
                    && mv -fT -- "${tmpf}" "$2/${name}"; then
                log "calendar: $2/${name} put back as it was before the deploy"
            else
                if [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
                rc=1
            fi
        fi
    done
    # the record of the lines this tool put in goes back with them
    if [[ -f "$1/calendar_applied.absent" ]]; then
        rm -f -- "${CAL_RECORD}" || rc=1
    elif [[ -f "$1/calendar_applied.orig" ]]; then
        { cp -a -- "$1/calendar_applied.orig" "${CAL_RECORD}.new" && mv -fT -- "${CAL_RECORD}.new" "${CAL_RECORD}"; } || rc=1
    fi
    return "${rc}"
}
cal_keep() {   # $1 = tag, $2 = its list, fetched whole: kept in CAL_LISTS, the only one there
    local f
    { mkdir -p -- "${CAL_LISTS}" && cp -- "$2" "${CAL_LISTS}/.$1.new" && mv -fT -- "${CAL_LISTS}/.$1.new" "${CAL_LISTS}/$1"; } 2>/dev/null || return 1
    for f in "${CAL_LISTS}"/v*; do if [[ "${f}" != "${CAL_LISTS}/$1" ]]; then rm -f -- "${f}"; fi; done
}
cal_list() {   # $1 = tag, $2 = output: that release's list from CAL_LISTS, else fetched and kept there.
               # Only a list that arrived whole with a 200 is kept: 3 = no list was found (404), 1 = not
               # fetched; neither keeps anything, so the next run asks again
    if [[ -f "${CAL_LISTS}/$1" && ! -L "${CAL_LISTS}/$1" ]]; then cp -- "${CAL_LISTS}/$1" "$2"; return; fi
    cal_conf_fetch "$1" "$2" || return
    cal_keep "$1" "$2" || true
}
cal_run() {   # every run, at any hour: the installed release's list, with the rules of a run (cal_held)
    local d got=0
    [[ "${deployed}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
    d="$(mktemp -d)" || return 1
    cal_list "${deployed}" "${d}/nse-calendar.conf" || got=$?
    if [[ ${got} -eq 0 ]]; then
        cal_sync run "${d}/nse-calendar.conf" "${CAL_DIR}" "${d}" "$(cal_today)" || true
    elif [[ ${got} -eq 3 ]]; then
        cal_note "calendar: no list was found for ${deployed}; the next run asks again"
    else
        cal_note "calendar: could not fetch the list of ${deployed} whole; the next run tries again"
    fi
    rm -rf -- "${d}"
}
gate_view() {   # keep the day files as this run found them, for market_open, before cal_run changes any
    local f d="${STATE}/calendar-gate"
    mkdir -p -- "${d}" || return 1
    for f in nse_holidays.txt nse_extra_trading_days.txt; do
        rm -f -- "${d}/${f}" || return 1
        if [[ -f "${CAL_DIR}/${f}" ]]; then cp -- "${CAL_DIR}/${f}" "${d}/${f}" || return 1; fi
    done
    GATE_VIEW="${d}"
}
cal_preview() {   # $1 = the list a release brings, $2 = a new private folder. In $2/etc: the day files as
