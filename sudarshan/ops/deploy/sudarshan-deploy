    echo "latest release: ${tag:-none} | deployed: ${deployed} | asset: ${asset_url:-MISSING} | market_open: $(market_open && echo yes || echo no)"
    if [[ "${tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then   # what that release would change in .env and the day files
        ck="$(mktemp -d)"; trap 'rm -rf "${ck}"' EXIT
