        if [[ -n "${mark}" && "$(cat -- "${seen}" 2>/dev/null)" == "${mark}" ]]; then mode=quiet; fi
        cal_sync "${mode}" "${d}/nse-calendar.conf" "${CAL_DIR}" "${d}" || true
