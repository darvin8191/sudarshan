        elif ! env_sync check "${ck}/openalgo-env.conf" "${ENV_FILE}" "${ck}"; then echo "settings: the list of ${tag} is not valid"; fi
        got=0; cal_conf_fetch "${tag}" "${ck}/nse-calendar.conf" || got=$?
