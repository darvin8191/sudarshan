# ---- the .env settings of this release, fetched and checked while OpenAlgo still runs: a list that
# cannot be fetched or read stops the deploy before anything is touched.
env_conf="${tmp}/openalgo-env.conf"; mkdir -m 700 "${tmp}/env-plan" "${tmp}/env" "${tmp}/cal"
env_conf_fetch "${tag}" "${env_conf}" || { log "could not fetch the settings list of ${tag} - not deploying"; exit 1; }
env_sync check "${env_conf}" "${ENV_FILE}" "${tmp}/env-plan" || { log "the settings list of ${tag} is not valid - not deploying"; exit 1; }
# ---- the calendar lines of this release, fetched while OpenAlgo still runs. Unlike the settings, a
# list that cannot be fetched or read never stops the deploy: the day files then stay as they are,
# nothing is kept, and the runs after the install fetch the list again (cal_run).
cal_conf="${tmp}/nse-calendar.conf"; got=0
cal_conf_fetch "${tag}" "${cal_conf}" || got=$?
if [[ ${got} -eq 3 ]]; then log "calendar: no list was found for ${tag}; the day files stay as they are"; cal_conf=""
elif [[ ${got} -ne 0 ]]; then log "calendar: could not fetch the list of ${tag} whole; the day files stay as they are"; cal_conf=""; fi
# ---- self-update: a release may carry a newer version of this tool. It is read straight from
# GitHub at the release tag (never from APP_DIR, which the service user can write), checked, and
# used from the NEXT run on - so a fixed tool arrives even when this run's deploy fails.
self_update() {
    local url="https://raw.githubusercontent.com/${OWNER_REPO}/${tag}/sudarshan/ops/deploy/sudarshan-deploy"
    local new="${tmp}/sudarshan-deploy.new" me
    me="$(readlink -f "$0")"
    curl -fsSL --max-time "${FETCH_TIMEOUT}" "${url}" -o "${new}" 2>/dev/null || return 0      # this release carries no tool
    cmp -s "${new}" "${me}" && return 0                            # already current
    if bash -n "${new}" 2>/dev/null && grep -q '^# sudarshan-deploy' "${new}"; then
        cp -a "${me}" "${me}.prev" 2>/dev/null || true
        install -m 755 "${new}" "${me}.tmp" && mv -f "${me}.tmp" "${me}"
        log "deploy tool updated from ${tag} (used from the next run; previous kept as ${me}.prev)"
    else
        log "WARNING: the deploy tool in ${tag} failed the syntax check - kept the current one"
    fi
}
self_update
as_svc timeout "${GIT_TIMEOUT}" git -C "${APP_DIR}" fetch --tags --quiet sudarshan
as_svc git -C "${APP_DIR}" rev-parse -q --verify "refs/tags/${tag}^{commit}" > /dev/null || { log "tag ${tag} not found after fetch"; exit 1; }
prev_ref="$(as_svc git -C "${APP_DIR}" rev-parse HEAD)"
UV=(env UV_PYTHON_DOWNLOADS=never /usr/local/bin/uv pip install --quiet --python "${APP_DIR}/.venv/bin/python" -r "${APP_DIR}/requirements-nginx.txt")
ring_db_backup() {
    (
        set +eEu; trap - ERR
        local dir folder f name dest owner
        for dir in "${RING_VAR}"/sudarshan-*/; do
            [[ -d "${dir}" && ! -L "${dir%/}" ]] || continue
            folder="$(basename "${dir}")"
            # The family store's copy for the nightly backup (Y9), not a store: the store itself is copied
            # from the family's own folder, and a copy put back as 600 would shut the nightly job out of it.
            [[ "${folder}" != "${FAM_USER}-export" ]] || continue
            owner=""
            for f in "${dir}"*.db; do
                [[ -f "${f}" && ! -L "${f}" ]] || continue
                name="$(basename "${f}")"
                ring_name_ok "${folder}" "${name}" || { log "ring: ${folder}/${name}: unusual name - not backed up"; continue; }
                if [[ -z "${owner}" ]] && ! owner="$(ring_owner "${dir%/}")"; then   # copied as the folder's own account
                    log "WARNING: ring: ${folder} belongs to ${owner:-an unknown account}, not to ${RING_USER} or ${FAM_USER} - its databases are not backed up"
                    break
                fi
                dest="${bdir}/ring/${folder}/${name}"
                if mkdir -p "${bdir}/ring/${folder}" && rm -f "${dest}" && db_copy_out "${owner}" "${f}" "${dest}"; then
                    log "ring: backed up ${folder}/${name}"
                else
                    rm -f "${dest}"; log "WARNING: ring: could not back up ${folder}/${name} - a rollback leaves it as it is"
                fi
            done
        done
    ) || true
}
ring_db_restore() {
    (
        set +eEu; trap - ERR
        local f folder name dir dest owner
        for f in "${bdir}"/ring/*/*.db; do
            [[ -f "${f}" && ! -L "${f}" ]] || continue
            folder="$(basename "$(dirname "${f}")")"; name="$(basename "${f}")"
            ring_name_ok "${folder}" "${name}" || continue
            dir="${RING_VAR}/${folder}"; dest="${dir}/${name}"
            [[ -d "${dir}" && ! -L "${dir}" ]] || { log "ring: ${folder} is gone - ${name} not put back"; continue; }
            if ! owner="$(ring_owner "${dir}")"; then   # written by the folder's own account, never by root
                log "WARNING: ring: ${folder} belongs to ${owner:-an unknown account}, not to ${RING_USER} or ${FAM_USER} - ${name} not put back"
                continue
            fi
            # the copy is written whole beside the database first, so a failure leaves the database and its journal as they were
            if db_copy_in "${owner}" "${f}" "${dest}"; then log "ring: put back ${folder}/${name}"
            else log "WARNING: ring: could not put back ${folder}/${name}"; fi
        done
    ) || true
}
ring_status() {   # $1 = a ring service (sudarshan-<service>.service): before it starts, log what every migrate module
                  # it has says with --status (sudarshan/<service>/migrate.py, and one folder down), run as the account
                  # that owns the service's state folder. No module, no line; no state folder yet (no store), no line.
    (
        set +eEu; trap - ERR
        local svc="${1#sudarshan-}" m mod out rc dir owner
        svc="${svc%.service}"
        [[ "${svc}" =~ ^[a-z0-9_]+$ ]] || exit 0
        dir="${RING_VAR}/sudarshan-${svc}"
        [[ -d "${dir}" && ! -L "${dir}" ]] || exit 0
        if ! owner="$(ring_owner "${dir}")"; then
            log "WARNING: ring: sudarshan-${svc} belongs to ${owner:-an unknown account}, not to ${RING_USER} or ${FAM_USER} - its migration status is not asked"
            exit 0
        fi
        cd "${APP_DIR}" || exit 0
        for m in "sudarshan/${svc}/migrate.py" "sudarshan/${svc}"/*/migrate.py; do
            [[ -f "${m}" && ! -L "${m}" ]] || continue
            mod="${m%.py}"; mod="${mod//\//.}"
            [[ "${mod}" =~ ^sudarshan(\.[a-z0-9_]+)+\.migrate$ ]] || continue
            out="$(timeout 60 sudo -u "${owner}" -H -- "${APP_DIR}/.venv/bin/python" -m "${mod}" --status 2>&1)"; rc=$?
            if [[ -n "${out}" ]]; then
                printf '%s\n' "${out}" | head -n 30 | while IFS= read -r line; do log "ring: ${mod} --status: ${line:0:300}"; done
            fi
            [[ ${rc} -eq 0 ]] || log "WARNING: ring: ${mod} --status did not finish cleanly (exit ${rc})"
        done
    ) || true
}
rollback() {
    trap - ERR; set +e
    trap '' TERM INT HUP   # a second signal does not cut the rollback short
    log "!! rolling back to ${prev_ref}"
    systemctl stop "${SERVICE}"
    as_svc git -C "${APP_DIR}" checkout -f --detach "${prev_ref}"
    as_svc "${UV[@]}" || log "WARNING: re-installing the previous Python packages failed"
    dist_put "${bdir}/frontend-dist-prev.tar.gz" || log "WARNING: the previous frontend could not be put back"
    for b in "${bdir}"/*.db; do
        [[ -f "${b}" ]] || continue
        n="$(basename "${b}")"
        db_copy_in "${SVC_USER}" "${b}" "${APP_DIR}/db/${n}" || log "WARNING: ${n} could not be put back"
    done
    if [[ -f "${bdir}/historify.duckdb" ]]; then
        file_copy_in "${SVC_USER}" "${bdir}/historify.duckdb" "${APP_DIR}/db/historify.duckdb" "${APP_DIR}/db/historify.duckdb.wal" \
            || log "WARNING: historify.duckdb could not be put back"
    fi
    # .env goes back with the databases: a start may have rewritten it (OpenAlgo saves FERNET_SALT)
    env_restore "${tmp}/env" "${ENV_FILE}" || log "WARNING: could not put the previous ${ENV_FILE} back"
    cal_restore "${tmp}/cal" "${CAL_DIR}" || log "WARNING: calendar: could not put the previous day files back"
    chown -R "${SVC_USER}:${SVC_USER}" "${APP_DIR}/frontend/dist" "${APP_DIR}/db"
    ring_db_restore   # the ring's databases go back with the code, before anything starts
    systemctl start "${SERVICE}"; log "rollback done (${SERVICE} $(systemctl is-active "${SERVICE}"))"
    for u in $(ring_services); do ring_status "${u}"; systemctl start "${u}" || log "WARNING: ${u} did not start after rollback"; done
    # One notice per release, cause and outcome: the timer tries a release that failed again at its next
    # run, and each of those must not become another message.
    local up; up="$([[ "$(systemctl is-active "${SERVICE}" 2>/dev/null)" == active ]] && echo yes || echo no)"
    notice rolled_back "deploy-rolledback-${tag}-${ROLLBACK_WHY}-${up}" tag="${tag}" was="${deployed}" why="${ROLLBACK_WHY}" up="${up}"
}
# ---- stop first: no requests, no DB writes and no half-old/half-new code during the update.
# From here on ANY error rolls back and starts the service again (never leave openalgo stopped).
# The downloads take time, so the market gate is asked once more right before the stop: if the
# window opened meanwhile, the install waits as it would have at the first gate.
if market_open && [[ ${FORCE} -eq 0 ]]; then
    log "release ${tag} waiting for market close (the window opened during the download)"
    notice waiting "deploy-wait-${tag}" tag="${tag}"
    rm -f -- "${bdir}/prev_ref"; rmdir -- "${bdir}" 2>/dev/null || true
    exit 0
fi
# The calendar list this release brings may make today a trading day (a special session for today,
# or today's holiday taken back): the gate is also asked of the day files as the install would leave
# them, so such a release waits as it will once the list is in place.
if [[ -n "${cal_conf}" && ${FORCE} -eq 0 ]] && cal_preview "${cal_conf}" "${tmp}/cal-gate" \
        && ( GATE_VIEW="${tmp}/cal-gate/etc"; market_open ); then
    log "release ${tag} waiting for market close (its calendar list makes today a trading day)"
    notice waiting "deploy-wait-${tag}" tag="${tag}"
    rm -f -- "${bdir}/prev_ref"; rmdir -- "${bdir}" 2>/dev/null || true
    exit 0
fi
log "stopping ${SERVICE} for the update"
for u in $(ring_services); do systemctl stop "${u}" || true; done   # same code tree, so same window
systemctl stop "${SERVICE}"
trap 'log "unexpected error at line ${LINENO}"; rollback; exit 1' ERR
on_signal() {   # a stop by the system, ^C or a hangup in the middle of an install is a failure like any other
    trap '' TERM INT HUP PIPE
    # the log writer was stopped with us, and its pipe with it: a new one, to the same two places
    exec > >(exec 9>&-; exec tee -a "${STATE}/deploy-${ts}.log" >&8 8>&-) 2>&1
    log "stopped by a signal"
    ROLLBACK_WHY="error"; rollback; exit 1
}
trap on_signal TERM INT HUP
# ---- backups (SQLite online backup API, DuckDB copy while stopped, previous dist, previous ref). Each
# database is copied by the user who owns it (db_copy_out), and the folder stays root's alone, mode 700:
# nobody who can write OpenAlgo's folders can change what a rollback restores from. Nothing in it is
# readable by others, not even for a moment (umask 077).
old_umask="$(umask)"; umask 077
echo "${prev_ref}" > "${bdir}/prev_ref"
for db in "${APP_DIR}"/db/*.db; do
    if [[ -f "${db}" ]]; then db_copy_out "${SVC_USER}" "${db}" "${bdir}/$(basename "${db}")"; fi
done
if [[ -f "${APP_DIR}/db/historify.duckdb" ]]; then file_copy_out "${SVC_USER}" "${APP_DIR}/db/historify.duckdb" "${bdir}/historify.duckdb"; fi
ring_db_backup   # X8: the ring is stopped; its databases are copied under ${bdir}/ring, apart from db/
fam_backup || true   # the family account's keys under ${bdir}/etc-family, never put back by a rollback
tar -czf "${bdir}/frontend-dist-prev.tar.gz.partial" -C "${APP_DIR}/frontend" dist
mv -f "${bdir}/frontend-dist-prev.tar.gz.partial" "${bdir}/frontend-dist-prev.tar.gz"
chmod -R go-rwx "${bdir}"
umask "${old_umask}"
# ---- code + dist + deps + migrations
as_svc git -C "${APP_DIR}" checkout -f --detach "refs/tags/${tag}"
dist_put "${tmp}/${ASSET}"
as_svc "${UV[@]}"
if [[ -f "${APP_DIR}/sudarshan/requirements.txt" ]]; then
    as_svc env UV_PYTHON_DOWNLOADS=never /usr/local/bin/uv pip install --quiet --python "${APP_DIR}/.venv/bin/python" -r "${APP_DIR}/sudarshan/requirements.txt"
fi
# OpenAlgo's .env gets the settings this release lists (backed up first; a rollback puts it back)
if ! env_sync apply "${env_conf}" "${ENV_FILE}" "${tmp}/env" "${bdir}/openalgo.env"; then log "updating ${ENV_FILE} failed"; ROLLBACK_WHY=settings; rollback; exit 1; fi
# The day files get the calendar lines this release lists (the files it changes are backed up first,
# and a rollback puts them back). A bad list or a failed write is logged; the install goes on.
if [[ -n "${cal_conf}" ]]; then
    if ! cal_sync install "${cal_conf}" "${CAL_DIR}" "${tmp}/cal" "$(cal_today)" "${bdir}"; then
        log "WARNING: calendar: the day files did not take every line of ${tag}; the install goes on"
    fi
fi
# migrate_all.py runs each migration with sys.executable, so the venv python is enough (no 'uv run').
if ! as_svc bash -c "cd '${APP_DIR}/upgrade' && '${APP_DIR}/.venv/bin/python' migrate_all.py"; then log "migrations failed"; ROLLBACK_WHY=migrations; rollback; exit 1; fi
# ---- start + health (this is our own service; TRINETRA is never touched)
systemctl start "${SERVICE}"
ok=0; code=""
for _ in $(seq 1 90); do sleep 2; code="$(curl -s --max-time 10 -o /dev/null -w '%{http_code}' http://127.0.0.1:5000/ || true)"; [[ "${code}" == "200" || "${code}" == "302" ]] && { ok=1; break; }; done
if [[ ${ok} -eq 1 ]]; then
    trap - ERR TERM INT HUP
    echo "${tag}" > "${STATE}/deployed_tag"; log "deployed ${tag} OK (http ${code}); backup in ${bdir}"
    chmod 644 "${STATE}/deployed_tag" 2>/dev/null || true   # the ring's health shows the release (sudarshan/ops/release.py)
    notice installed "deploy-${NOTICE_RUN}-installed" tag="${tag}" was="${deployed}" \
        backup="$([[ -s "${bdir}/frontend-dist-prev.tar.gz" ]] && echo yes || echo no)"
    printf '%s\n' "${tag}" > "${STATE}/notice_announced" 2>/dev/null || true
    # the list this install applied, fetched whole, is the one the next runs (cal_run) apply
    if [[ -n "${cal_conf}" ]]; then cal_keep "${tag}" "${cal_conf}" || true; fi
else
    log "health check failed after start (last http ${code:-none})"; ROLLBACK_WHY=health; rollback; exit 1
fi
# ---- ring services: install the unit files of this release and (re)start them. A failing ring
# service is reported but never rolls back OpenAlgo (trading does not depend on them).
ring_deploy() {
    local list n f names=() changed=0 old state
    list="$(curl -fsSL --max-time "${FETCH_TIMEOUT}" -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/${OWNER_REPO}/contents/sudarshan/ops/systemd?ref=${tag}" 2>/dev/null)" || list='[]'
    mkdir -p "${tmp}/units"
    while IFS= read -r n; do
        [[ -n "${n}" ]] || continue
        f="${tmp}/units/${n}"
        if ! curl -fsSL --max-time "${FETCH_TIMEOUT}" "https://raw.githubusercontent.com/${OWNER_REPO}/${tag}/sudarshan/ops/systemd/${n}" -o "${f}"; then log "ring: download of ${n} failed - skipped"; continue; fi
        if unit_ok "${f}" "${n}"; then names+=("${n}")
        else log "ring: ${n} REFUSED by the unit policy"; notice unit_refused "deploy-refused-${tag}-${n}" tag="${tag}" unit="${n}"; fi
    done < <(jq -r '.[]? | select(.type=="file") | .name | select(test("^sudarshan(-[a-z0-9-]+\\.(service|timer)|\\.slice)$"))' <<< "${list}")
    for n in "${names[@]}"; do
        if ! cmp -s "${tmp}/units/${n}" "${UNIT_DIR}/${n}"; then
            install -m 644 -o root -g root "${tmp}/units/${n}" "${UNIT_DIR}/${n}"; changed=1; log "ring: installed ${n}"
        fi
    done
    for old in $(managed_units); do   # units this tool installed before but the release dropped
        if [[ " ${names[*]} " != *" ${old} "* ]]; then
            systemctl disable --now "${old}" > /dev/null 2>&1 || true
            rm -f "${UNIT_DIR:?}/${old}"; changed=1; log "ring: removed ${old}"
        fi
    done
    [[ ${changed} -eq 1 ]] && systemctl daemon-reload
    printf '%s\n' "${names[@]}" > "${MANAGED}"
    for n in "${names[@]}"; do [[ "${n}" == *.service ]] && ring_env "${n}"; done
    for n in "${names[@]}"; do
        if [[ "${n}" == *.slice ]]; then continue; fi   # a slice has nothing to start
        if [[ "${n}" == *.timer ]]; then
            systemctl enable --now "${n}" > /dev/null 2>&1 || log "ring: ${n} could not be enabled"
        else
            systemctl enable "${n}" > /dev/null 2>&1 || true
            ring_status "${n}"   # X8: what the service's stores will do on this start, in the log
            systemctl restart "${n}" || log "ring: ${n} did not start"
        fi
    done
    if [[ ${#names[@]} -gt 0 ]]; then
        sleep 5
        for n in "${names[@]}"; do
            [[ "${n}" == *.slice ]] && continue
            state="$(systemctl is-active "${n}" 2>/dev/null || true)"
            if [[ "${n}" == *.service && "${state}" != "active" ]] && ring_skipped "${n}"; then
                log "ring: ${n} not started: its start condition is not met yet"   # not a failure: nothing to wait for
                continue
            fi
            log "ring: ${n} ${state}"
            [[ "${n}" == *.service ]] && ring_health "${n}"
        done
    fi
}
ring_skipped() {   # $1 = a service: 0 when its last start was skipped because a Condition...= line did not hold
                   # (the family view's until its set-up has passed its check). systemd reports such a start as
                   # done and leaves the unit inactive: it is not a failed start, so no warning, no health wait
    [[ "$(systemctl show -p ConditionResult --value -- "$1" 2>/dev/null)" == "no" ]]
}
# ---- a ring service's own settings file, /etc/sudarshan/<service>.env (root:sudarshan 640, cross-design
# R3): a release may ship sudarshan/ops/deploy/<service>-env.conf in openalgo-env.conf's format; each key
# is added when absent or moved off a default an earlier release shipped, and a value the owner chose
# stays. A missing file is made first, empty. A release without a list changes nothing here.
ring_env() {   # $1 = sudarshan-<service>.service
    (
        set +eEu; trap - ERR
        local svc="${1#sudarshan-}" conf out got envf work dir="${CAL_DIR}" group="${RING_USER}"
        svc="${svc%.service}"
        [[ "${svc}" =~ ^[a-z0-9]+$ ]] || exit 0
        if [[ "$1" == "${FAM_UNIT}" ]]; then   # its account cannot read /etc/sudarshan (Y1): its file is in its own folder,
            dir="${FAM_DIR}"; group="${FAM_USER}"   # which exists only after the owner's set-up (until then the unit cannot start)
            cal_dir_ok "${FAM_DIR}" || exit 0
        fi
        conf="${tmp}/${svc}-env.conf"
        release_file "${svc}-env.conf" "${tag}" "${conf}"; got=$?
        [[ ${got} -eq 0 && -s "${conf}" ]] || { [[ ${got} -eq 1 ]] && log "ring: the settings list of ${svc} could not be fetched whole; its file stays as it is"; exit 0; }
        envf="${dir}/${svc}.env"
        if [[ -L "${envf}" ]]; then log "ring: ${envf} is a link - left alone"; exit 0; fi
        if [[ ! -e "${envf}" ]]; then
            install -m 640 -o root -g "${group}" /dev/null "${envf}" 2>/dev/null || install -m 640 /dev/null "${envf}" || { log "ring: ${envf} could not be made"; exit 0; }
            log "ring: made ${envf}"
        fi
        work="${tmp}/ring-env-${svc}"; mkdir -m 700 -p "${work}"
        env_sync apply "${conf}" "${envf}" "${work}" "${bdir}/${svc}.env" || log "WARNING: ring: ${envf} did not take every setting of ${tag}"
    ) || true
}
# ---- a ring service's /health after its start (R14: one listener per service on its port). Not
# answering within 30 s is a WARNING with what the owner can check, never a rollback: trading does
# not depend on the ring.
ring_port() { case "$1" in sudarshan-feed.service) echo 5580 ;; sudarshan-alerts.service) echo 5582 ;;
              sudarshan-portfolio.service) echo 5583 ;; sudarshan-screener.service) echo 5584 ;;
              sudarshan-family.service) echo 5585 ;; sudarshan-journal.service) echo 5586 ;; *) echo "" ;; esac; }
ring_health() {   # $1 = sudarshan-<service>.service
    (
        set +eEu; trap - ERR
        local port body state i
        port="$(ring_port "$1")"; [[ -n "${port}" ]] || exit 0
        for i in 1 2 3 4 5 6; do
            body="$(curl -s --max-time 5 "http://127.0.0.1:${port}/health" 2>/dev/null)" || body=""
            if [[ -n "${body}" ]]; then
                state="$(jq -r '.state // empty' <<< "${body}" 2>/dev/null)"
                log "ring: $1 health: ${state:-answered} (release $(jq -r '.release // "unknown"' <<< "${body}" 2>/dev/null))"
                exit 0
            fi
            sleep 5
        done
        log "WARNING: ring: $1 did not answer on 127.0.0.1:${port}/health within 30 s; see journalctl -u $1"
    ) || true
}
fam_provision run || true   # with the release just installed, before the ring starts: its own check decides
ring_deploy || log "WARNING: ring service step failed - OpenAlgo itself is deployed"
# keep the 10 newest backups: the folders this tool makes (<date>-<time>-<tag>), by their names, which
# sort by time; whatever else is in the folder is not the tool's to remove
prune_backups() {
    local name n=0
    while IFS= read -r -d '' name; do
        n=$((n + 1))
        if (( n > 10 )); then rm -rf -- "/opt/sudarshan/backups/${name}"; fi
    done < <(find /opt/sudarshan/backups -mindepth 1 -maxdepth 1 -type d -regextype posix-extended \
        -regex '.*/[0-9]{8}-[0-9]{6}-v[0-9]+\.[0-9]+\.[0-9]+' -printf '%f\0' | sort -z -r)
}
prune_backups || true
