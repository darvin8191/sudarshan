    if grep -Eq "^${ws}Exec[A-Za-z]*${ws}=${ws}[-@:]*[+!]" "${f}"; then log "unit ${n}: privileged exec prefix (+ or !)"; return 1; fi
    if grep -Eiq "^${ws}(AmbientCapabilities|CapabilityBoundingSet|SupplementaryGroups|PermissionsStartOnly|DynamicUser|RootDirectory|RootImage|PAMName|CPUSchedulingPolicy|CPUSchedulingPriority|IOSchedulingClass|IOSchedulingPriority)${ws}=" "${f}"; then log "unit ${n}: forbidden setting"; return 1; fi
