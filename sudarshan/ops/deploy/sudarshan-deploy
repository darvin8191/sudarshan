#!/usr/bin/env bash
# sudarshan-deploy — bring the live OpenAlgo to the latest GitHub Release tag of the fork.
# Design (first version, deliberately simple): the code is checked out IN PLACE in APP_DIR
# (git checkout -f of the tag), frontend/dist is replaced by the CI-built release asset,
# Python deps are refreshed the same way the installer did it (uv pip -r requirements-nginx.txt),
# migrations run, openalgo restarts, health is checked. No releases/current symlink layout yet:
# the systemd unit, nginx and the venv all point at APP_DIR, and changing that would touch the
# live unit. Rollback = previous git ref + previous frontend/dist tarball + SQLite .backup copies.
# Lives in the repo at sudarshan/ops/deploy/sudarshan-deploy; every release can update it.
# Also manages the SUDARSHAN ring services: unit files under sudarshan/ops/systemd at the tag
# (sudarshan-*.service / .timer) are fetched from GitHub, checked against a strict policy (never
# root, no privileged exec prefixes, capabilities or realtime scheduling), installed and restarted.
# And OpenAlgo's .env gets the settings the release lists in sudarshan/ops/deploy/openalgo-env.conf
# (added when missing, replaced only while they hold a default an earlier release shipped).
# And the NSE day files in /etc/sudarshan get the calendar lines the release lists in
# sudarshan/ops/deploy/nse-calendar.conf, on every run, also when nothing is installed and in market
# hours (a shipped date is added when missing; only a line an earlier release shipped is replaced,
# and nothing that could open the market gate on the day changes outside an install).
# And on every run the price feed's client tokens in /etc/sudarshan/feed-clients are made once if
# missing (feed_tokens), and, only once the owner's one-time set-up for the family view
# (sudarshan/ops/family/bootstrap.sh) has made /etc/sudarshan-family, that account's keys are kept
# there and its check is run (fam_provision). Before that set-up nothing of the family is touched.
# And once the owner has installed the family view's nginx lines (sudarshan/ops/nginx), every run checks,
# reading only, that they are still in place, loaded and the release's (ngx_check); it never edits nginx.
# Usage: sudarshan-deploy [--check | --redeploy | --force | --family-provision | --nginx-check]
#   --check     show latest Release / deployed tag / market state and the .env settings and
#               calendar lines that release would change, change nothing
#   --redeploy  install the latest Release again even if it is already deployed (still gated)
#   --force     like --redeploy but ALSO ignores the market-hours gate (root only, emergencies)
#   --remove-ring sudarshan-<service>
#               take one ring service out: stop and disable its unit, copy its databases into a
#               backup folder, remove the unit file; its state folder and /etc/sudarshan/<service>.env
#               stay (an owner's settings are never deleted). The next release that still ships the
#               unit installs it again.
#   --family-provision
#               the family view's provision step alone (the feed tokens, the keys, the check), saying
#               everything it does; bootstrap.sh runs it. Waits up to 15 minutes for a running
#               install. Exit 0 = the check passed, 1 = it did not, 2 = no /etc/sudarshan-family yet.
#   --nginx-check
#               whether the family view's nginx lines are installed, loaded by nginx and this release's,
#               one line each, changing nothing (it neither waits for nor stops an install).
#               Exit 0 = all of it holds, 1 = not (each FAIL line says what to do).
set -Eeuo pipefail
MODE="deploy"; FORCE=0; REDEPLOY=0; REMOVE_RING=""
case "${1:-}" in
    --check) MODE="check" ;;
    --redeploy) REDEPLOY=1 ;;
    --force) FORCE=1; REDEPLOY=1 ;;
    --remove-ring) MODE="remove-ring"; REMOVE_RING="${2:-}" ;;
    --family-provision) MODE="family" ;;
    --nginx-check) MODE="nginx" ;;
    "") ;;
    *) echo "usage: sudarshan-deploy [--check|--redeploy|--force|--remove-ring sudarshan-<service>|--family-provision|--nginx-check]" >&2; exit 2 ;;
esac
# shellcheck disable=SC1091
source /etc/sudarshan/deploy.env
STATE="/var/lib/sudarshan"; mkdir -p "${STATE}"
exec 9> "${STATE}/deploy.lock"
if [[ "${MODE}" == "family" ]]; then   # the owner is waiting at the set-up: an install is waited for, not skipped
    flock -w 900 9 || { echo "An install is still running. Nothing was changed: run the set-up again in a few minutes."; exit 75; }
elif [[ "${MODE}" == "nginx" ]]; then
    :   # it only reads, so it takes no lock: an install neither holds it up nor is held up by it
else
    flock -n 9 || { echo "another deploy is running"; exit 0; }
fi
# The nightly backup runs as the ring's user and opens this lock to wait for an install: a lock it cannot
# open, or a folder it cannot walk into, is read as "no tool here" and lets the backup run in the middle
# of an install. So both are made readable, on every run, whatever umask the unit has.
chmod 644 "${STATE}/deploy.lock" 2>/dev/null || true
chmod o+x "${STATE}" 2>/dev/null || true
OWNER_REPO="${REPO#https://github.com/}"
as_svc() { sudo -u "${SVC_USER}" -H -- "$@"; }
RING_USER="sudarshan"   # the user every ring service runs as (unit_ok insists on it), but one:
FAM_USER="sudarshan-family"; FAM_UNIT="${FAM_USER}.service"   # the family view runs as its own account
                        # (P6), and unit_ok allows that account for that unit alone
RING_VAR="/var/lib"     # where the ring services keep their state: ${RING_VAR}/sudarshan-<service>/
FAM_DIR="/etc/sudarshan-family"         # the family account's keys (root:sudarshan-family 750, files 640)
FEED_DIR="/etc/sudarshan/feed-clients"  # the price feed's client tokens (root:sudarshan 750, files 640)
log() { echo "[$(date '+%F %T %Z')] $*"; }
listed() {   # 0 = date $1 starts a line of file $2 (a trailing comment is allowed, as auto-login reads
             # it). Only a regular file is read: grep would wait forever on a FIFO.
    # As autologin/schedule.py reads it: ASCII spaces (C locale), NUL inside a line (-a), a BOM.
    local bom=$'\xef\xbb\xbf'
    [[ -f "$2" ]] && LC_ALL=C grep -aqE "^(${bom})?[[:space:]]*${1}([[:space:]#]|$)" "$2" 2>/dev/null
}
day_trading() {   # $1 = date, $2 = ISO weekday, $3 = HHMM, $4 = holiday file, $5 = extra-days file;
                  # 0 = within trading hours by those files
    # A special session (a weekend or holiday session the exchange announces, such as Muhurat
    # trading) keeps its own hours, so nothing is restarted at any time that day.
    listed "$1" "$5" && return 0
    [[ "$2" -ge 6 ]] && return 1
    listed "$1" "$4" && return 1
    # 10# forces decimal: "0930" would otherwise be read as an invalid octal number
    local t=$((10#$3))
    # 08:30-16:00 (SUDARSHAN M0.1): clear of auto-login's wake-ups, the alerts' 08:45 opening and
    # the feed's 08:58; until the alerts' 16:00 close, after the F&O close at 15:40 and the feed's
    # tail to 15:50. From 7 Dec 2026 F&O closes at 15:45, the feed's tail is 15:55 and the alerts
    # close at 16:05; the gate stays 16:00 (the owner's rule), so an install from 16:01 to 16:05
    # can restart the alerts while connected (the v0.8.1 notes say so)
    (( t >= 830 && t <= 1600 ))
}
market_open() {   # 0 = trading hours (do not restart), 1 = safe. Trading when the day files say so as
                  # they are, or as they stood before this run's calendar step (GATE_VIEW, kept by
                  # gate_view): that step can make a day a trading day, never take one away.
    local now dow hhmm today
    now="$(TZ=Asia/Kolkata date '+%u %H%M %F')"; read -r dow hhmm today <<< "${now}"
    if [[ -n "${GATE_VIEW:-}" ]] && day_trading "${today}" "${dow}" "${hhmm}" \
            "${GATE_VIEW}/nse_holidays.txt" "${GATE_VIEW}/nse_extra_trading_days.txt"; then
        return 0
    fi
    day_trading "${today}" "${dow}" "${hhmm}" /etc/sudarshan/nse_holidays.txt /etc/sudarshan/nse_extra_trading_days.txt
}
# ---- Notices: what the owner is told on Telegram about a release (M18.x). This tool runs as root and
# holds no Telegram or OpenAlgo secret, so it only records facts, one JSON line each, in ${EVENTS}.
# sudarshan-alerts (user sudarshan, which can read the file) words each message and sends it once per
# event id (sudarshan/alerts/notices.py; the line format is in sudarshan/ops/events.py). The facts of
# one run share NOTICE_RUN and are told in one message. Recording is best effort and runs in a
# subshell with its own error handling: a missing jq, a full disk or a read-only folder costs the
# notice, never an install or a rollback. The file and ${STATE} are made readable for the ring (mode
# 644, the folder traversable), as is deployed_tag, which the services' health shows.
EVENTS="${STATE}/events.jsonl"
NOTICE_RUN=""            # the id the facts of this run share
NOTICE_AT=""             # when it happened, if not now
ROLLBACK_WHY="error"     # why a rollback happens: health, migrations, settings or error
notice() {   # $1 = kind, $2 = event id, then fact=value words. An id already recorded is not recorded again
    (
        set +eEu; trap - ERR
        local id="$2" pair line
        local -a args
        args=(--arg v 1 --arg src deploy --arg kind "$1" --arg id "${id}" --arg at "${NOTICE_AT:-$(date +%s)}" --arg run "${NOTICE_RUN:-${id}}")
        shift 2
        for pair in "$@"; do args+=(--arg "${pair%%=*}" "${pair#*=}"); done
        # already recorded: a whole line (it ends in the closing brace) holds the id. A line cut off by a crash does not count
        if [[ -f "${EVENTS}" ]] && grep -F -- "\"id\":\"${id}\"" "${EVENTS}" | grep -q '}$'; then exit 0; fi
        line="$(jq -cn "${args[@]}" '$ARGS.named')" && [[ -n "${line}" ]] || exit 0
        if [[ ! -e "${EVENTS}" ]]; then : > "${EVENTS}" && chmod 644 "${EVENTS}" || exit 0; fi
        # a last line a crash left without its newline is ended first, or this record would be glued to it and lost
        if [[ -s "${EVENTS}" && "$(tail -c 1 -- "${EVENTS}"; printf x)" != $'\nx' ]]; then printf '\n' >> "${EVENTS}" || exit 0; fi
        printf '%s\n' "${line}" >> "${EVENTS}" || exit 0
        chmod o+x "${STATE}"
        if (( $(wc -l < "${EVENTS}") > 400 )); then   # the newest 200 lines are kept
            tail -n 200 "${EVENTS}" > "${EVENTS}.new" && chmod 644 "${EVENTS}.new" && mv -f "${EVENTS}.new" "${EVENTS}"
        fi
    ) > /dev/null 2>&1 || true
}
notice_catch_up() {   # the first run of a tool that records notices tells the install the tool before it made
                      # without a word, if it was in the last 12 hours. Said once per tag (notice_announced)
    local said made
    [[ "${deployed}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
    said="$(cat "${STATE}/notice_announced" 2>/dev/null || true)"
    [[ "${said}" != "${deployed}" ]] || return 0
    printf '%s\n' "${deployed}" > "${STATE}/notice_announced" 2>/dev/null || return 0
    made="$(stat -c %Y "${STATE}/deployed_tag" 2>/dev/null)" || return 0
    (( $(date +%s) - made <= 43200 )) || return 0
    NOTICE_AT="${made}" NOTICE_RUN="catchup-${deployed}"
    notice installed "deploy-catchup-${deployed}" tag="${deployed}" \
        backup="$(compgen -G "/opt/sudarshan/backups/*-${deployed}" > /dev/null && echo yes || echo no)"
    NOTICE_AT="" NOTICE_RUN=""
}
# ---- OpenAlgo .env settings a release needs: sudarshan/ops/deploy/openalgo-env.conf, whose header
# gives the format. Read from GitHub at the release tag, like this tool and the unit files. A key is
# added when missing and replaced only while it holds an old value listed for it, so a value the
# owner chose stays. .env holds secrets: nothing from it is printed, only managed key names and
# the values the release sets. Root works on a private copy and moves the result into place, so a
# symlink planted in APP_DIR or in the backup folder is never followed.
ENV_FILE="${APP_DIR}/.env"
FETCH_TIMEOUT=60        # seconds one list from GitHub may take
DOWNLOAD_TIMEOUT=900    # seconds the release's frontend may take
GIT_TIMEOUT=600         # seconds the fetch of the code may take
release_file() {   # $1 = file in sudarshan/ops/deploy, $2 = tag, $3 = output. 0 = fetched whole, with a 200
                   # (an empty file is an empty list); 3 = the release has no such file (404: $3 is left
                   # empty); 1 = not fetched: no answer, an error, or a body cut off in transit (curl then
                   # fails although it saw 200) or not ending in a newline
    local code
    code="$(curl -sSL --max-time "${FETCH_TIMEOUT}" -o "$3" -w '%{http_code}' "https://raw.githubusercontent.com/${OWNER_REPO}/$2/sudarshan/ops/deploy/$1" 2>/dev/null)" || return 1
    case "${code}" in
        200) [[ ! -s "$3" || "$(tail -c 1 -- "$3"; printf x)" == $'\nx' ]] ;;
        404) : > "$3"; return 3 ;;
        *) return 1 ;;
    esac
}
env_conf_fetch() { release_file openalgo-env.conf "$1" "$2" || [[ $? -eq 3 ]]; }   # $1 = tag, $2 = output;
                                                                                    # no list: an empty one
env_sync() {   # $1 = check|apply, $2 = settings list, $3 = .env, $4 = private work dir (root only),
               # $5 = backup to write (apply). 0 = done or nothing to do, 1 = bad list or I/O error.
    local mode="$1" conf="$2" env="$3" work="$4" backup="${5:-}"
    local LC_ALL=C   # bytes, not characters: in a UTF-8 locale a stray byte hides a line from =~
    local orig="$4/env.orig" new="$4/env.new" q="'" eol=$'\n' line k v pre n=0 prev=0 spans=0
    local re_key='^[A-Za-z_][A-Za-z0-9_]*$' re_word='^[A-Za-z0-9._:/@+,-]+$'
    local re_bind='^([[:space:]]*(export[[:space:]]+)?)([^=#[:space:]]+)([[:space:]]*=[[:space:]]*)(.*)$'
    local re_qkey="^[${q}\"](.*)[${q}\"]\$"
    local re_sq="^${q}([^${q}\\]*)${q}([[:space:]]*(#.*)?)\$"   # 'value' # comment
    local re_dq='^"([^"\$]*)"([[:space:]]*(#.*)?)$'            # "value" # comment
    local re_uq="^([^[:space:]${q}\"][^[:space:]]*)?(([[:space:]]+#.*)?[[:space:]]*)\$"
    local w_add="added" w_set="set"
    local -a words=() keys=() add=() changed_keys=() repl=()
    local -A want=() olds=() count=() line_of=() cur=() lead=() post=() odd=()
    if [[ "${mode}" == "check" ]]; then w_add="would add"; w_set="would set"; fi
    [[ -f "${conf}" && -r "${conf}" ]] || { log "settings: the list ${conf} is missing"; return 1; }
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        read -r -a words <<< "${line%%#*}"
        [[ ${#words[@]} -gt 0 ]] || continue
        k="${words[0]}"
        if [[ ${#words[@]} -lt 2 || ! "${k}" =~ ${re_key} || -n "${want[${k}]+set}" ]]; then
            log "settings: list line ${n} is not a new KEY followed by VALUE and OLD values"; return 1
        fi
        olds[${k}]="|"
        for v in "${words[@]:1}"; do
            if [[ "${v}" == "''" ]]; then v=""; elif [[ ! "${v}" =~ ${re_word} ]]; then
                log "settings: list line ${n} has a value with a character the list does not allow"; return 1
            fi
            if [[ -z "${want[${k}]+set}" ]]; then want[${k}]="${v}"; else olds[${k}]+="${v}|"; fi
        done
        keys+=("${k}")
    done < "${conf}"
    rm -rf -- "${orig}" "${new}"
    if [[ ! -e "${env}" && ! -L "${env}" ]]; then log "settings: there is no ${env}, so nothing is changed"; return 0; fi
    # cp -a never follows a symlink (it opens the source with O_NOFOLLOW) and never reads a FIFO
    if ! cp -a -- "${env}" "${orig}" 2>/dev/null || [[ -L "${orig}" || ! -f "${orig}" ]]; then
        rm -rf -- "${orig}"; log "WARNING: settings: ${env} is not a plain file, so it is left alone"; return 0
    fi
    if [[ "${mode}" == "apply" ]] && ! { cp -a -- "${orig}" "${work}/env.backup" && chmod 600 "${work}/env.backup" \
            && mv -fT -- "${work}/env.backup" "${backup}"; }; then
        log "settings: could not back up ${env}"; return 1
    fi
    n=0
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        [[ "${line}" =~ ${re_bind} ]] || continue
        pre="${BASH_REMATCH[1]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"; k="${BASH_REMATCH[3]}"; v="${BASH_REMATCH[5]}"
        if [[ "${k}" =~ ${re_qkey} ]]; then k="${BASH_REMATCH[1]}"; fi   # python-dotenv reads 'KEY'=
        case "${v}" in   # a quote not closed on its line runs on: this line-by-line edit stays away
            \'*) [[ "${v:1}" == *\'* ]] || spans=1 ;;
            \"*) [[ "${v:1}" == *\"* ]] || spans=1 ;;
        esac
        [[ -n "${want[${k}]+set}" ]] || continue
        count[${k}]=$(( ${count[${k}]:-0} + 1 )); line_of[${k}]=${n}; lead[${k}]="${pre}"
        if [[ "${v}" =~ ${re_sq} || "${v}" =~ ${re_dq} || "${v}" =~ ${re_uq} ]]; then
            cur[${k}]="${BASH_REMATCH[1]}"; post[${k}]="${BASH_REMATCH[2]}"
        else
            odd[${k}]=1
        fi
    done < "${orig}"
    if [[ "${mode}" == "check" ]]; then rm -f -- "${orig}"; fi   # a copy of secrets kept no longer than needed
    if [[ ${spans} -eq 1 ]]; then
        log "WARNING: settings: ${env} has a value running over several lines, so it is left alone"; return 0
    fi
    for k in "${keys[@]}"; do
        v="${want[${k}]}"
        if [[ -z "${count[${k}]:-}" ]]; then
            add+=("${k}"); changed_keys+=("${k}"); log "settings: ${w_add} ${k}='${v}'"
        elif [[ ${count[${k}]} -gt 1 ]]; then
            log "settings: ${k} left alone: .env sets it ${count[${k}]} times"
        elif [[ -n "${odd[${k}]:-}" ]]; then
            log "settings: ${k} left alone: its line is in a form this tool does not rewrite"
        elif [[ "${cur[${k}]}" == "${v}" ]]; then
            :
        elif [[ "${olds[${k}]}" == *"|${cur[${k}]}|"* ]]; then   # the guard: only a shipped default
            repl[${line_of[${k}]}]="${lead[${k}]}'${v}'${post[${k}]}"; changed_keys+=("${k}")
            log "settings: ${w_set} ${k}='${v}' in place of a default an earlier release shipped"
        else
            log "settings: ${k} left alone: the owner chose its value"
        fi
    done
    [[ ${#changed_keys[@]} -gt 0 ]] || { log "settings: nothing to change in ${env}"; return 0; }
    [[ "${mode}" == "apply" ]] || return 0
    if grep -q $'\r$' "${orig}"; then eol=$'\r\n'; fi
    # The copy keeps owner, group, mode and ACLs; only the listed lines are rewritten, every other
    # byte comes from sed/tail, and the result replaces .env in one rename.
    { cp -a -- "${orig}" "${new}" && : > "${new}"; } || { log "settings: could not write ${new}"; return 1; }
    for n in "${!repl[@]}"; do
        if [[ ${n} -gt $((prev + 1)) ]]; then sed -n "$((prev + 1)),$((n - 1))p" "${orig}" >> "${new}" || return 1; fi
        printf '%s\n' "${repl[${n}]}" >> "${new}" || return 1
        prev=${n}
    done
    tail -n "+$((prev + 1))" "${orig}" >> "${new}" || return 1
    if [[ ${#add[@]} -gt 0 && -s "${new}" && -n "$(tail -c 1 "${new}")" ]]; then printf '%s' "${eol}" >> "${new}" || return 1; fi
    for k in "${add[@]}"; do printf "%s='%s'%s" "${k}" "${want[${k}]}" "${eol}" >> "${new}" || return 1; done
    mv -fT -- "${new}" "${env}" || { log "settings: could not replace ${env}"; return 1; }
    log "settings: ${env} updated (${changed_keys[*]}); the previous one is in ${backup}"
}
env_restore() {   # $1 = env_sync's work dir, $2 = .env: put back the copy env_sync took before any change
    [[ -f "$1/env.orig" ]] || return 0   # this deploy never read .env, so it never changed it
    cp -a -- "$1/env.orig" "$1/env.restore" && mv -fT -- "$1/env.restore" "$2" || return 1
    log "settings: ${2} put back as it was before the deploy"
}
# ---- NSE calendar lines a release ships: sudarshan/ops/deploy/nse-calendar.conf, whose header gives
# the format, merged into the day files the market gate above, auto-login and the order alerts read.
# They read a changed file again by themselves, so every run applies the list of the installed release
# (cal_run) and an install the list of the release it brings (backed up, put back on a rollback).
# A missing shipped date is added; a line is replaced only while it is a version a release shipped
# for that date, and dropped only when this tool added it; a line the owner wrote stays, and a line
# he took out stays out. A run that installs nothing changes no line dated today or earlier (except
# that it adds a special session for today) and never decides its own market gate. A holiday is never
# added on or after its day, and an install whose list would make today a trading day waits
# (cal_preview). Notes are logged once while they hold, changes once written. A failure is logged and
# never stops an install or a rollback.
CAL_DIR="/etc/sudarshan"
# A day file the list creates gets the owner and mode of the other files there (sudarshan/README.md).
CAL_OWNER="root:${SVC_USER}"; CAL_MODE=640
CAL_RECORD="${STATE}/calendar_applied"   # each line this tool put in a day file and has not dropped
CAL_NOTES="${STATE}/calendar_notes"      # the notes logged so far, each once while it holds
CAL_LISTS="${STATE}/calendar-lists"      # the installed release's list, once fetched whole
GATE_VIEW=""                             # the day files as this run found them (gate_view)
cal_conf_fetch() { release_file nse-calendar.conf "$1" "$2"; }   # $1 = tag, $2 = output
cal_today() {   # today's date in IST, from the clock the market gate reads
    local now
    now="$(TZ=Asia/Kolkata date '+%u %H%M %F')" && printf '%s\n' "${now##* }"
}
cal_day_ok() {   # 0 = $1 is a date that exists, written YYYY-MM-DD (the form the market gate matches)
    local y m d last=31
    [[ "$1" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]] || return 1
    y=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]})); d=$((10#${BASH_REMATCH[3]}))
    case "${m}" in
        4|6|9|11) last=30 ;;
        2) last=28; if (( y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) )); then last=29; fi ;;
    esac
    (( y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= last ))
}
cal_dir_ok() {   # 0 = $1 is a real folder owned by the user this tool runs as, writable by no one else
    local st
    [[ -d "$1" && ! -L "$1" ]] && st="$(stat -c '%u %a' -- "$1")" || return 1
    [[ "${st% *}" == "${EUID}" ]] && (( (8#${st#* } & 8#022) == 0 ))
}
cal_held() {   # $1 = check|run|install, $2 = today, $3 = file, $4 = date, $5 = add|replace|drop.
               # 0, with the reason on stdout, when that change must not be made now; 1 when it may
    if [[ "$3" == "nse_holidays.txt" && "$5" == "add" && ! "$4" > "$2" ]]; then
        echo "not added: a holiday is added only before its day"; return 0
    fi
    if [[ "$1" == "run" && ! "$4" > "$2" ]] \
            && [[ "$3" != "nse_extra_trading_days.txt" || "$5" != "add" || "$4" != "$2" ]]; then
        echo "kept as it is: a run that installs nothing changes no line dated today or earlier (an install does)"
        return 0
    fi
    return 1
}
cal_note() {   # $1 = a note: logged once while it holds (cal_flush keeps the notes that do)
    if [[ -f "${CAL_NOTES}" ]] && grep -qxF -- "$1" "${CAL_NOTES}"; then return 0; fi
    log "$1"; printf '%s\n' "$1" 2>/dev/null >> "${CAL_NOTES}" || true
}
cal_flush() {   # $1 = check|run|install, then the notes of one cal_sync. check logs them all; else
                # each is logged once while it holds, and the notes kept are the ones that hold now.
    local mode="$1" w
    local -A had=()
    shift
    if [[ "${mode}" == "check" ]]; then for w in "$@"; do log "${w}"; done; return 0; fi
    if [[ -f "${CAL_NOTES}" ]]; then while IFS= read -r w; do if [[ -n "${w}" ]]; then had[${w}]=1; fi; done < "${CAL_NOTES}"; fi
    for w in "$@"; do if [[ -z "${had[${w}]+set}" ]]; then log "${w}"; fi; done
    { if [[ $# -gt 0 ]]; then printf '%s\n' "$@"; fi; } 2>/dev/null > "${CAL_NOTES}.new" && mv -fT -- "${CAL_NOTES}.new" "${CAL_NOTES}" 2>/dev/null
}
cal_sync() {   # $1 = check|run|install, $2 = calendar list, $3 = folder of the day files, $4 = private
               # work dir (root only), $5 = today (YYYY-MM-DD, IST), $6 = the install's backup folder:
               # a file the install changes is copied there first and kept in $4 for cal_restore.
               # run: every run (see cal_held); check: as install, writing nothing.
               # 0 = done or nothing to do, 1 = a bad list or a file not written.
    local mode="$1" conf="$2" dir="$3" work="$4" today="$5" backup="${6:-}"
    local LC_ALL=C   # bytes, not characters, as in env_sync
    local t=$'\t' cr=$'\r' nl=$'\n' line kw text day key name="" re form bad="" why n=0 k=-1 i r w
    local path snap tmpf eol prev ok exists present ours bare rc=0 told=0 recnew=0
    local grow="added" swap="replaced" cut="removed"
    local re_skip='^[[:space:]]*(#|$)' re_file='^[[:blank:]]*\[([^]]*)\][[:space:]]*$'
    local re_kw='^[[:blank:]]*(line|was|drop)[[:blank:]]+(.*[^[:space:]])[[:space:]]*$'
    local re_hol="^([0-9]{4}-[0-9]{2}-[0-9]{2})([ ${t}]+#[ -~${t}]*)?\$"
    local re_xtra="^([0-9]{4}-[0-9]{2}-[0-9]{2})([ ${t}]+([0-9]{2}):([0-9]{2})-([0-9]{2}):([0-9]{2}))?([ ${t}]+#[ -~${t}]*)?\$"
    local -a names=() e_file=() e_kind=() e_text=() e_day=() e_olds=() sec=() lines=() trim=() lday=()
    local -a oldof=() dropof=() done_=() repl=() gone=() edit=() adds=() found=() owners=() notes=()
    local -a said=() tally=()
    local -A files=() days=() texts=() rec=()
    if [[ "${mode}" == "check" ]]; then grow="would add"; swap="would replace"; cut="would remove"; fi
    [[ -f "${conf}" && -r "${conf}" ]] || { log "calendar: the list ${conf} is missing"; return 1; }
    while IFS= read -r line || [[ -n "${line}" ]]; do
        n=$((n + 1))
        if [[ "${line}" =~ ${re_skip} ]]; then
            continue
        elif [[ "${line}" =~ ${re_file} ]]; then
            name="${BASH_REMATCH[1]}"; k=-1
            if [[ "${name}" != "nse_holidays.txt" && "${name}" != "nse_extra_trading_days.txt" ]]; then
                bad="list line ${n} names a file other than nse_holidays.txt and nse_extra_trading_days.txt"; break
            elif [[ -n "${files[${name}]+set}" ]]; then
                bad="list line ${n} names ${name} a second time"; break
            fi
            files[${name}]=1; names+=("${name}"); continue
        elif [[ ! "${line}" =~ ${re_kw} ]]; then
            bad="list line ${n} is not a [FILE], line, was or drop line"; break
        fi
        kw="${BASH_REMATCH[1]}"; text="${BASH_REMATCH[2]}"
        if [[ -z "${name}" ]]; then bad="list line ${n} comes before the first [FILE] line"; break; fi
        if [[ "${name}" == "nse_holidays.txt" ]]; then re="${re_hol}"; form="YYYY-MM-DD"
        else re="${re_xtra}"; form="YYYY-MM-DD, an optional HH:MM-HH:MM window"; fi
        if [[ ! "${text}" =~ ${re} ]]; then
            bad="list line ${n} is not ${form} and an optional # comment, in plain ASCII"; break
        fi
        day="${BASH_REMATCH[1]}"
        if [[ -n "${BASH_REMATCH[3]:-}" ]] && ! (( 10#${BASH_REMATCH[3]} < 24 && 10#${BASH_REMATCH[4]} < 60
                && 10#${BASH_REMATCH[5]} < 24 && 10#${BASH_REMATCH[6]} < 60 && 10#${BASH_REMATCH[3]} * 60
                + 10#${BASH_REMATCH[4]} < 10#${BASH_REMATCH[5]} * 60 + 10#${BASH_REMATCH[6]} )); then
            bad="list line ${n} has a window that is not HH:MM-HH:MM with the start before the end"; break
        fi
        if ! cal_day_ok "${day}"; then bad="list line ${n} has a date that does not exist"; break; fi
        key="${name}|${text}"
        if [[ -n "${texts[${key}]+set}" ]]; then bad="list line ${n} repeats a line of ${name}"; break; fi
        texts[${key}]=${n}
        if [[ "${kw}" == "was" ]]; then
            if [[ ${k} -lt 0 ]]; then bad="list line ${n} is a was with no line above it"; break; fi
            if [[ "${day}" != "${e_day[k]}" ]]; then bad="list line ${n} is a was for another date than its line"; break; fi
            e_olds[k]+="${text}${nl}"; continue
        fi
        if [[ "${kw}" == "line" ]]; then
            if [[ -n "${days[${name}/${day}]+set}" ]]; then bad="list line ${n} is a second line for ${day}"; break; fi
            days[${name}/${day}]=1
        fi
        k=${#e_text[@]}; e_file+=("${name}"); e_kind+=("${kw}"); e_text+=("${text}"); e_day+=("${day}"); e_olds+=("")
        if [[ "${kw}" == "drop" ]]; then k=-1; fi   # a was belongs to a line
    done < "${conf}"
    if [[ -n "${bad}" ]]; then cal_flush "${mode}" "calendar: ${bad}"; return 1; fi
    if [[ ${#e_text[@]} -eq 0 ]]; then   # a release without calendar lines
        cal_flush "${mode}" || true
        if [[ "${mode}" != "run" ]]; then log "calendar: nothing to change in ${dir}"; fi
        return 0
    fi
    if [[ ! "${today}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        cal_flush "${mode}" "calendar: the date today is not known, so the day files are left alone"; return 1
    fi
    if ! cal_dir_ok "${dir}"; then
        notes+=("calendar: ${dir} is not a folder owned by root and closed to others, so the day files are left alone")
        if [[ "${mode}" != "check" ]]; then cal_flush "${mode}" "${notes[@]}"; return 1; fi
    elif [[ "${mode}" != "check" ]]; then
        while IFS= read -r -d '' w; do   # a temporary file a killed run left behind
            if rm -f -- "${w}"; then log "calendar: removed ${w}, left by an interrupted run"; fi
        done < <(find "${dir}" -maxdepth 1 -type f \( -name '.nse_holidays.txt.??????' \
            -o -name '.nse_extra_trading_days.txt.??????' \) -mmin +10 -print0 2>/dev/null)
    fi
    if [[ -f "${CAL_RECORD}" ]]; then while IFS= read -r w; do if [[ -n "${w}" ]]; then rec[${w}]=1; fi; done < "${CAL_RECORD}"; fi
    for name in "${names[@]}"; do
        path="${dir}/${name}"; snap="${work}/${name}.snap"; exists=0
        sec=(); lines=(); trim=(); lday=(); oldof=(); dropof=(); done_=(); repl=(); gone=(); edit=()
        adds=(); said=(); tally=()
        for k in "${!e_file[@]}"; do if [[ "${e_file[k]}" == "${name}" ]]; then sec+=("${k}"); fi; done
        [[ ${#sec[@]} -gt 0 ]] || continue
        if [[ -L "${path}" ]] || [[ -e "${path}" && ! -f "${path}" ]]; then
            notes+=("WARNING: calendar: ${path} is not a plain file, so it is left alone"); continue
        elif [[ -e "${path}" ]]; then   # read from a private copy (cp -a never follows a symlink)
            if ! { rm -f -- "${snap}" && cp -a -- "${path}" "${snap}" && mapfile -t lines < "${snap}"; } 2>/dev/null; then
                notes+=("calendar: could not read ${path}, so it is left as it was"); rc=1; continue
            fi
            exists=1
        fi
        for i in "${!lines[@]}"; do   # each line as the readers see it: its text and the date it lists
            line="${lines[i]}"; trim[i]="${line%"${line##*[![:space:]]}"}"
            line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; lday[i]="${line%%[[:space:]]*}"
            [[ -n "${trim[i]}" ]] || continue
            for k in "${sec[@]}"; do
                if [[ "${e_kind[k]}" == "drop" ]]; then
                    if [[ "${trim[i]}" == "${e_text[k]}" ]]; then dropof[i]=${k}; fi
                elif [[ "${nl}${e_olds[k]}" == *"${nl}${trim[i]}${nl}"* ]]; then oldof[i]=${k}; fi
            done
        done
        # Drops, then replacements, then additions: a line a release takes out never counts as the
        # owner's, and a date a drop frees can take the new line.
        for r in 0 1 2; do
            for k in "${sec[@]}"; do
                [[ -z "${done_[k]:-}" ]] || continue
                if [[ "${e_kind[k]}" == "drop" ]]; then
                    done_[k]=1; found=()
                    for i in "${!trim[@]}"; do if [[ -z "${gone[i]:-}" && "${dropof[i]:-}" == "${k}" ]]; then found+=("${i}"); fi; done
                    if [[ ${#found[@]} -eq 0 ]]; then
                        :
                    elif [[ "${rec[${name}|${e_text[k]}]:-}" != 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: this tool did not add \"${e_text[k]}\", so the owner did (a release drops only lines it added)")
                    elif why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" drop)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        for i in "${found[@]}"; do gone[i]=1; edit[i+1]=1; done
                        said+=("calendar: ${name}: ${cut} \"${e_text[k]}\""); tally+=("-${name}|${e_text[k]}")
                    fi
                    continue
                fi
                [[ ${r} -ge 1 ]] || continue
                present=0; found=(); owners=()
                for i in "${!trim[@]}"; do
                    [[ -z "${gone[i]:-}" ]] || continue
                    if [[ "${trim[i]}" == "${e_text[k]}" ]]; then present=1
                    elif [[ "${oldof[i]:-}" == "${k}" ]]; then found+=("${i}")
                    elif [[ -z "${oldof[i]:-}" && "${lday[i]}" == "${e_day[k]}" ]]; then owners+=("${i}"); fi
                done
                if [[ ${present} -eq 1 ]]; then
                    done_[k]=1
                elif [[ ${#found[@]} -eq 1 && ${#owners[@]} -eq 0 ]]; then
                    done_[k]=1; i=${found[0]}
                    if why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" replace)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        said+=("calendar: ${name}: ${swap} \"${trim[i]}\" with \"${e_text[k]}\""); tally+=("+${name}|${e_text[k]}")
                        repl[i+1]="${e_text[k]}"; edit[i+1]=1; trim[i]="${e_text[k]}"; lday[i]="${e_day[k]}"; unset 'oldof[i]'
                    fi
                elif [[ ${r} -eq 2 ]]; then
                    done_[k]=1; ours=0
                    while IFS= read -r w; do
                        if [[ -n "${w}" && "${rec[${name}|${w}]:-}" == 1 ]]; then ours=1; fi
                    done <<< "${e_text[k]}${nl}${e_olds[k]}"
                    if [[ $(( ${#found[@]} + ${#owners[@]} )) -gt 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: the file lists it $(( ${#found[@]} + ${#owners[@]} )) times")
                    elif [[ ${#owners[@]} -eq 1 ]]; then
                        w="${trim[${owners[0]}]//[^ -~]/?}"
                        notes+=("calendar: ${name}: ${e_day[k]} left alone: the owner wrote it as \"${w:0:100}\" (this release ships \"${e_text[k]}\")")
                    elif [[ ${ours} -eq 1 ]]; then
                        notes+=("calendar: ${name}: ${e_day[k]} not added again: this tool added it before, and it was taken out by hand")
                    elif why="$(cal_held "${mode}" "${today}" "${name}" "${e_day[k]}" add)"; then
                        notes+=("calendar: ${name}: ${e_day[k]} ${why}")
                    else
                        said+=("calendar: ${name}: ${grow} \"${e_text[k]}\""); tally+=("+${name}|${e_text[k]}")
                        adds+=("${e_text[k]}"); trim+=("${e_text[k]}"); lday+=("${e_day[k]}")
                    fi
                fi
            done
        done
        [[ ${#said[@]} -gt 0 ]] || continue
        if [[ "${mode}" == "check" ]]; then
            for w in "${said[@]}"; do log "${w}"; done
            if [[ ${exists} -eq 0 ]]; then log "calendar: would create ${path} (${CAL_OWNER} ${CAL_MODE})"; fi
            told=1; continue
        fi
        if [[ "${mode}" == "install" ]]; then   # the previous file, before any change
            ok=0
            if [[ ${exists} -eq 0 ]]; then
                : > "${work}/${name}.absent" && ok=1
            elif { cp -a -- "${snap}" "${work}/${name}.orig" && cp -a -- "${snap}" "${work}/${name}.bak" \
                    && mv -fT -- "${work}/${name}.bak" "${backup}/${name}"; } 2>/dev/null; then
                ok=1
            fi
            if [[ ${ok} -eq 0 ]]; then
                rm -f -- "${work}/${name}.orig" "${work}/${name}.absent" "${work}/${name}.bak"
                notes+=("calendar: could not back up ${path}, so it is left as it was"); rc=1; continue
            fi
        fi
        # The new file gets the old one's owner, group and mode (or those of a new day file), is
        # written next to it through one descriptor and renamed over it: a reader sees the old file
        # or the new one, never half of one.
        eol="${nl}"; if [[ ${exists} -eq 1 ]] && grep -q "${cr}\$" "${snap}"; then eol="${cr}${nl}"; fi
        bare=0   # the kept text ends with no newline, so an addition starts a line of its own first
        if [[ ${exists} -eq 1 && -s "${snap}" && -z "${edit[${#lines[@]}]+set}" \
                && "$(tail -c 1 "${snap}"; printf x)" != "${nl}x" ]]; then bare=1; fi
        ok=0
        if tmpf="$(mktemp -p "${dir}" ".${name}.XXXXXX" 2>/dev/null)"; then
            ok=1
            if [[ ${exists} -eq 1 ]]; then
                { chown -h --reference="${snap}" -- "${tmpf}" && chmod --reference="${snap}" -- "${tmpf}"; } 2>/dev/null || ok=0
            else
                { chown -h -- "${CAL_OWNER}" "${tmpf}" && chmod -- "${CAL_MODE}" "${tmpf}"; } 2>/dev/null || ok=0
            fi
            if [[ ${ok} -eq 1 ]]; then
                {
                    prev=0
                    for i in "${!edit[@]}"; do   # every other byte comes from sed/tail, as in env_sync
                        if [[ ${i} -gt $((prev + 1)) ]]; then sed -n "$((prev + 1)),$((i - 1))p" "${snap}" || ok=0; fi
                        if [[ -n "${repl[i]+set}" ]]; then   # a line in gone is left out
                            w="${nl}"; if [[ "${lines[i - 1]}" == *"${cr}" ]]; then w="${cr}${nl}"; fi
                            printf '%s%s' "${repl[i]}" "${w}" || ok=0
                        fi
                        prev=${i}
                    done
                    if [[ ${exists} -eq 1 ]]; then tail -n "+$((prev + 1))" "${snap}" || ok=0; fi
                    if [[ ${bare} -eq 1 && ${#adds[@]} -gt 0 ]]; then printf '%s' "${eol}" || ok=0; fi
                    for w in "${adds[@]}"; do printf '%s%s' "${w}" "${eol}" || ok=0; done
                } 2>/dev/null > "${tmpf}" || ok=0
            fi
            if [[ ${ok} -eq 0 ]] || ! mv -fT -- "${tmpf}" "${path}" 2>/dev/null; then rm -f -- "${tmpf}"; ok=0; fi
        fi
        if [[ ${ok} -eq 0 ]]; then
            rm -f -- "${work}/${name}.orig" "${work}/${name}.absent"
            notes+=("calendar: could not write ${path}, so it is left as it was"); rc=1; continue
        fi
        for w in "${said[@]}"; do log "${w}"; done
        if [[ ${exists} -eq 0 ]]; then log "calendar: ${path} created (${CAL_OWNER} ${CAL_MODE})"
        elif [[ -n "${backup}" ]]; then log "calendar: ${path} updated; the previous one is in ${backup}/${name}"
        else log "calendar: ${path} updated"; fi
        for w in "${tally[@]}"; do   # what this tool put in that file, and took out
            if [[ "${w}" == +* ]]; then rec[${w#+}]=1; else rec[${w#-}]=0; fi
        done
        told=1; recnew=1
    done
    rm -f -- "${work}"/*.snap
    if [[ ${recnew} -eq 1 ]]; then   # an install keeps the previous record in $4 for cal_restore
        if [[ "${mode}" == "install" && ! -e "${work}/calendar_applied.orig" && ! -e "${work}/calendar_applied.absent" ]]; then
            if [[ -f "${CAL_RECORD}" ]]; then cp -a -- "${CAL_RECORD}" "${work}/calendar_applied.orig" 2>/dev/null || rc=1
            else : > "${work}/calendar_applied.absent" || rc=1; fi
        fi
        if ! { for w in "${!rec[@]}"; do if [[ "${rec[${w}]}" == 1 ]]; then printf '%s\n' "${w}"; fi; done; } 2>/dev/null > "${CAL_RECORD}.new" \
                || ! mv -fT -- "${CAL_RECORD}.new" "${CAL_RECORD}" 2>/dev/null; then
            notes+=("calendar: could not save ${CAL_RECORD}"); rc=1
        fi
    fi
    cal_flush "${mode}" "${notes[@]}" || true
    if [[ ${told} -eq 0 && ${rc} -eq 0 && "${mode}" != "run" ]]; then log "calendar: nothing to change in ${dir}"; fi
    return "${rc}"
}
cal_restore() {   # $1 = cal_sync's work dir, $2 = folder of the day files: undo what an install changed,
                  # each file renamed into place whole, as it was (owner, group, mode and time)
    local name tmpf rc=0
    for name in nse_holidays.txt nse_extra_trading_days.txt; do
        if [[ -f "$1/${name}.absent" ]]; then
            if rm -f -- "$2/${name}"; then log "calendar: $2/${name} removed: the deploy had created it"; else rc=1; fi
        elif [[ -f "$1/${name}.orig" ]]; then
            tmpf=""
            if tmpf="$(mktemp -p "$2" ".${name}.XXXXXX")" && cp -a -- "$1/${name}.orig" "${tmpf}" \
                    && mv -fT -- "${tmpf}" "$2/${name}"; then
                log "calendar: $2/${name} put back as it was before the deploy"
            else
                if [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
                rc=1
            fi
        fi
    done
    # the record of the lines this tool put in goes back with them
    if [[ -f "$1/calendar_applied.absent" ]]; then
        rm -f -- "${CAL_RECORD}" || rc=1
    elif [[ -f "$1/calendar_applied.orig" ]]; then
        { cp -a -- "$1/calendar_applied.orig" "${CAL_RECORD}.new" && mv -fT -- "${CAL_RECORD}.new" "${CAL_RECORD}"; } || rc=1
    fi
    return "${rc}"
}
cal_keep() {   # $1 = tag, $2 = its list, fetched whole: kept in CAL_LISTS, the only one there
    local f
    { mkdir -p -- "${CAL_LISTS}" && cp -- "$2" "${CAL_LISTS}/.$1.new" && mv -fT -- "${CAL_LISTS}/.$1.new" "${CAL_LISTS}/$1"; } 2>/dev/null || return 1
    for f in "${CAL_LISTS}"/v*; do if [[ "${f}" != "${CAL_LISTS}/$1" ]]; then rm -f -- "${f}"; fi; done
}
cal_list() {   # $1 = tag, $2 = output: that release's list from CAL_LISTS, else fetched and kept there.
               # Only a list that arrived whole with a 200 is kept: 3 = no list was found (404), 1 = not
               # fetched; neither keeps anything, so the next run asks again
    if [[ -f "${CAL_LISTS}/$1" && ! -L "${CAL_LISTS}/$1" ]]; then cp -- "${CAL_LISTS}/$1" "$2"; return; fi
    cal_conf_fetch "$1" "$2" || return
    cal_keep "$1" "$2" || true
}
cal_run() {   # every run, at any hour: the installed release's list, with the rules of a run (cal_held)
    local d got=0
    [[ "${deployed}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
    d="$(mktemp -d)" || return 1
    cal_list "${deployed}" "${d}/nse-calendar.conf" || got=$?
    if [[ ${got} -eq 0 ]]; then
        cal_sync run "${d}/nse-calendar.conf" "${CAL_DIR}" "${d}" "$(cal_today)" || true
    elif [[ ${got} -eq 3 ]]; then
        cal_note "calendar: no list was found for ${deployed}; the next run asks again"
    else
        cal_note "calendar: could not fetch the list of ${deployed} whole; the next run tries again"
    fi
    rm -rf -- "${d}"
}
gate_view() {   # keep the day files as this run found them, for market_open, before cal_run changes any
    local f d="${STATE}/calendar-gate"
    mkdir -p -- "${d}" || return 1
    for f in nse_holidays.txt nse_extra_trading_days.txt; do
        rm -f -- "${d}/${f}" || return 1
        if [[ -f "${CAL_DIR}/${f}" ]]; then cp -- "${CAL_DIR}/${f}" "${d}/${f}" || return 1; fi
    done
    GATE_VIEW="${d}"
}
cal_preview() {   # $1 = the list a release brings, $2 = a new private folder. In $2/etc: the day files as
                  # that release's install would leave them, for market_open (GATE_VIEW). Made on copies,
                  # in a subshell that writes nothing outside $2 and logs nothing
    (
        mkdir -m 700 -- "$2" "$2/etc" "$2/work" "$2/bk" || exit 1
        for f in nse_holidays.txt nse_extra_trading_days.txt; do
            if [[ -f "${CAL_DIR}/${f}" && ! -L "${CAL_DIR}/${f}" ]]; then cp -p -- "${CAL_DIR}/${f}" "$2/etc/" || exit 1; fi
        done
        if [[ -f "${CAL_RECORD}" ]]; then cp -- "${CAL_RECORD}" "$2/calendar_applied" || exit 1; fi
        CAL_RECORD="$2/calendar_applied"; CAL_NOTES="$2/calendar_notes"
        cal_sync install "$1" "$2/etc" "$2/work" "$(cal_today)" "$2/bk" || true
    ) > /dev/null 2>&1
}
UNIT_DIR="/etc/systemd/system"; MANAGED="${STATE}/managed_units"
managed_units() { [[ -f "${MANAGED}" ]] && grep -E '^sudarshan(-[a-z0-9-]+\.(service|timer)|\.slice)$' "${MANAGED}" || true; }
ring_services() { managed_units | grep '\.service$' || true; }
unit_ok() {   # $1 = downloaded unit file, $2 = unit name; 0 = acceptable. It reads nothing but its arguments and
              # log, so the units' own tests can cut it out alone: the names default to the tool's values.
    local f="$1" n="$2" ws='[[:space:]]*' line waits=0
    local who="${RING_USER:-sudarshan}" fam="${FAM_USER:-sudarshan-family}" fam_dir="${FAM_DIR:-/etc/sudarshan-family}"
    if [[ "${n}" == "sudarshan.slice" ]]; then   # the ring's slice (R11): only resource limits and a description
        if grep -Eiv "^${ws}(#.*|\[(Unit|Slice)\]|Description${ws}=.*|(CPUWeight|CPUQuota|MemoryHigh|MemoryMax|TasksMax|IOWeight)${ws}=${ws}[0-9]+[%GMK]?|)${ws}$" "${f}" | grep -q .; then
            log "unit ${n}: a slice may carry only resource limits"; return 1
        fi
        return 0
    fi
    [[ "${n}" =~ ^sudarshan-[a-z0-9-]+\.(service|timer)$ ]] || { log "unit ${n}: bad name"; return 1; }
    case "${n}" in sudarshan-deploy.*|sudarshan-claude.*|sudarshan-dev.*) log "unit ${n}: reserved name"; return 1 ;; esac
    # The family view (P6) takes input from people who are not the owner, so it runs as its own account,
    # which can read none of the owner's secrets, and only once its check has passed: that one unit must
    # say User=sudarshan-family, may name no other user or group, and must wait for the file the check
    # writes. Every other unit must say User=sudarshan.
    if [[ "${n}" == "${fam}.service" ]]; then
        who="${fam}"
        while IFS= read -r line || [[ -n "${line}" ]]; do   # systemd skips a start until the check has passed
            if [[ "${line//[[:space:]]/}" == "ConditionPathExists=${fam_dir}/provisioned" ]]; then waits=1; fi
        done < "${f}"
        [[ ${waits} -eq 1 ]] || { log "unit ${n}: must say ConditionPathExists=${fam_dir}/provisioned"; return 1; }
    fi
    # every User=/Group= line must name that user (an empty value would reset to root)
    if grep -Ei "^${ws}(User|Group)${ws}=" "${f}" | grep -Eiqv "=${ws}${who}${ws}$"; then log "unit ${n}: User/Group other than ${who}"; return 1; fi
    if grep -Eq "^${ws}Exec[A-Za-z]*${ws}=${ws}[-@:]*[+!]" "${f}"; then log "unit ${n}: privileged exec prefix (+ or !)"; return 1; fi
    if grep -Eiq "^${ws}(AmbientCapabilities|CapabilityBoundingSet|SupplementaryGroups|PermissionsStartOnly|DynamicUser|RootDirectory|RootImage|PAMName|CPUSchedulingPolicy|CPUSchedulingPriority|IOSchedulingClass|IOSchedulingPriority)${ws}=" "${f}"; then log "unit ${n}: forbidden setting"; return 1; fi
    if grep -Eiq "^${ws}(Nice|OOMScoreAdjust)${ws}=${ws}-" "${f}"; then log "unit ${n}: negative Nice/OOMScoreAdjust"; return 1; fi
    if [[ "${n}" == *.service ]]; then
        grep -Eq "^${ws}User${ws}=${ws}${who}${ws}$" "${f}" || { log "unit ${n}: must say User=${who}"; return 1; }
        grep -Eiq "^${ws}NoNewPrivileges${ws}=${ws}(yes|true)${ws}$" "${f}" || { log "unit ${n}: must say NoNewPrivileges=yes"; return 1; }
    elif grep -Eq "^${ws}Unit${ws}=" "${f}" && ! grep -Eq "^${ws}Unit${ws}=${ws}sudarshan-[a-z0-9-]+\.service${ws}$" "${f}"; then
        log "unit ${n}: timer starts a non-SUDARSHAN unit"; return 1
    fi
    return 0
}
# ---- Databases, and files that live where their owner can write (review H1). A database sits in a folder
# its own user owns: OpenAlgo's db/ folder, a ring service's state folder. That user can
# plant a link or swap a name there at any moment, and a link that root follows is a write anywhere
# (cp, chown and chmod as root on a planted <db>.restoring overwrote and re-owned any file, for
# instance the settings root sources every ten minutes). So root never opens, copies, renames or
# chowns anything by a path in such a folder. The owner's user does the work, through a pipe:
#   db_copy_out USER DB COPY   USER runs SQLite's online backup of DB into a private temporary folder
#                              beside it and streams the copy out; root writes the stream into COPY, a
#                              new file in the backup folder, checks that it is a SQLite file and
#                              renames it into place.
#   db_copy_in USER COPY DB    root streams COPY (in the backup folder) in; USER writes it as a new
#                              file beside DB, removes DB's old journal files and renames the new file
#                              over DB. A rename replaces a link and follows none, so it ends at
#                              the database, never at what a link led to.
# The backup folder stays root's alone (mode 700): what root restores from cannot be changed.
read -r -d '' DB_OUT_SCRIPT <<'SH' || true
umask 077
d="$(mktemp -d -p "$(dirname -- "$1")" .backup.XXXXXX)" || exit 1
trap 'rm -rf -- "$d"' EXIT
sqlite3 "$1" ".backup '$d/copy'" > /dev/null 2>&1 && cat -- "$d/copy"
SH
read -r -d '' DB_IN_SCRIPT <<'SH' || true
umask 077
dest="$1"; dir="$2"; name="$3"; shift 3
t="$(mktemp -p "${dir}" ".${name}.XXXXXX")" || exit 1
if cat > "${t}" && rm -f -- "$@" && mv -fT -- "${t}" "${dest}"; then exit 0; fi
rm -f -- "${t}"
exit 1
SH
db_copy_out() {   # $1 = the database's user, $2 = the database, $3 = the copy to make. 0 = made
    local part="$3.partial"
    rm -f -- "${part}"
    # shellcheck disable=SC2024  # the redirect is root's on purpose: the stream lands in the backup folder
    if sudo -u "$1" -H -- sh -c "${DB_OUT_SCRIPT}" _ "$2" < /dev/null > "${part}" \
            && [[ "$(head -c 15 -- "${part}")" == "SQLite format 3" ]] && mv -fT -- "${part}" "$3"; then
        return 0
    fi
    rm -f -- "${part}"; return 1
}
file_copy_out() {   # $1 = the file's user, $2 = the file, $3 = the copy to make (a file as it is, for DuckDB)
    local part="$3.partial"
    rm -f -- "${part}"
    # shellcheck disable=SC2024  # the redirect is root's on purpose: the stream lands in the backup folder
    if sudo -u "$1" -H -- cat -- "$2" < /dev/null > "${part}" && mv -fT -- "${part}" "$3"; then return 0; fi
    rm -f -- "${part}"; return 1
}
file_copy_in() {   # $1 = the user, $2 = the copy, $3 = where it goes, then the files that must not meet it
                   # (a database's journal files). 0 = put back
    local user="$1" copy="$2" dest="$3"
    shift 3
    # shellcheck disable=SC2024  # root reads the copy from its own folder and feeds it in: the user never opens it
    sudo -u "${user}" -H -- sh -c "${DB_IN_SCRIPT}" _ "${dest}" "${dest%/*}" "${dest##*/}" "$@" < "${copy}"
}
db_copy_in() { file_copy_in "$1" "$2" "$3" "$3-wal" "$3-shm" "$3-journal"; }   # a stale journal must never meet a restored database
dist_put() {   # $1 = a tarball (root's) holding dist/: it replaces frontend/dist, written by the service user,
               # because the folder is the service user's to plant links in
    # shellcheck disable=SC2024  # root reads the tarball from its own folder and feeds it in
    sudo -u "${SVC_USER}" -H -- sh -c 'rm -rf -- "$1/dist" && tar -xzf - -C "$1"' _ "${APP_DIR}/frontend" < "$1"
}
# ---- the ring services' databases (X8): each ${RING_VAR}/sudarshan-*/*.db is copied with SQLite's online
# backup while the ring is stopped, into ${bdir}/ring/<folder>/<name>, never at the top of ${bdir}: the
# rollback puts every top-level *.db there back into OpenAlgo's db/ folder. A rollback puts each copy back in its
# own folder (owned by the ring's user, mode 600) before the ring starts. The sealed vault in db/ is in
# neither: it is not a top-level *.db, and what the owner typed after the backup must survive a rollback.
# Both run in a subshell with their own error handling: a ring database that cannot be copied or put
# back is logged and never stops an install or a rollback (trading does not depend on the ring).
ring_name_ok() { [[ "$1" =~ ^sudarshan-[a-z0-9-]+$ && "$2" =~ ^[A-Za-z0-9._-]+\.db$ ]]; }   # $1 = folder, $2 = file
ring_owner() {   # $1 = a ring state folder: prints the account that owns it (as stat names it). 0 when that is a
                 # ring account, sudarshan or sudarshan-family (Y13): its databases are copied, put back and
                 # asked about as that account. 1 for any other owner: nothing there is done, never as root
    local u
    u="$(stat -c %U -- "$1" 2>/dev/null)" || return 1
    printf '%s\n' "${u}"
    [[ "${u}" == "${RING_USER}" || "${u}" == "${FAM_USER}" ]]
}
# ---- --remove-ring: one ring service taken out by hand (an uninstall path besides a release dropping
# its unit). Its databases are copied into a backup folder first; the state folder and the settings
# file stay, so putting it back is a later release's unit install.
ring_remove() {   # $1 = sudarshan-<service>.service
    local n="$1" folder bdir
    [[ "${n}" =~ ^sudarshan-[a-z0-9-]+\.service$ ]] || { echo "usage: sudarshan-deploy --remove-ring sudarshan-<service>.service" >&2; exit 2; }
    [[ "${n}" != "${SERVICE}.service" ]] || { echo "${n} is OpenAlgo itself, not a ring service" >&2; exit 2; }
    folder="${n%.service}"
    bdir="/opt/sudarshan/backups/$(date +%Y%m%d-%H%M%S)-remove-${folder}"
    mkdir -m 700 -p "${bdir}"
    systemctl disable --now "${n}" > /dev/null 2>&1 || log "ring: ${n} was not running"
    if [[ "${folder}" != "sudarshan-feed" ]]; then   # the keys it claimed at the feed (under its name) go with it
        local code work="" tokf="${FEED_DIR}/${folder}"
        local -a auth=()
        # The feed takes a change of a client's claims only with that client's token (Y3.3). It is
        # handed to curl in a file of root's own, never on the command line, where ps would show it.
        if [[ -f "${tokf}" && ! -L "${tokf}" ]] && work="$(mktemp -d)" \
                && { printf 'Authorization: Bearer '; head -n 1 -- "${tokf}"; } > "${work}/auth" 2>/dev/null; then
            auth=(-H "@${work}/auth")
        fi
        code="$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "${auth[@]}" -X DELETE "http://127.0.0.1:5580/claims/${folder}" 2>/dev/null)" || code=""
        if [[ -n "${work}" ]]; then rm -rf -- "${work}"; fi
        if [[ "${code}" == "200" ]]; then log "ring: the price feed no longer keeps ${folder}'s instruments"
        else log "WARNING: ring: the price feed did not drop ${folder}'s instruments (is sudarshan-feed running?); it lets them go after 7 days without a renewal"; fi
    fi
    if [[ -d "${RING_VAR}/${folder}" && ! -L "${RING_VAR}/${folder}" ]]; then
        local f name owner
        if ! owner="$(ring_owner "${RING_VAR}/${folder}")"; then
            log "WARNING: ring: ${folder} belongs to ${owner:-an unknown account}, not to ${RING_USER} or ${FAM_USER} - its databases are not copied"
        else
            for f in "${RING_VAR}/${folder}"/*.db; do
                [[ -f "${f}" && ! -L "${f}" ]] || continue
                name="$(basename -- "${f}")"
                ring_name_ok "${folder}" "${name}" || continue
                mkdir -p "${bdir}/ring/${folder}"
                if db_copy_out "${owner}" "${f}" "${bdir}/ring/${folder}/${name}"; then log "ring: backed up ${folder}/${name} before removal"
                else log "WARNING: ring: could not back up ${folder}/${name}"; fi
            done
        fi
    fi
    rm -f "${UNIT_DIR:?}/${n}"
    if [[ -f "${MANAGED}" ]]; then grep -vx "${n}" "${MANAGED}" > "${MANAGED}.new" || true; mv -f "${MANAGED}.new" "${MANAGED}"; fi
    systemctl daemon-reload > /dev/null 2>&1 || true
    log "ring: removed ${n}; its state in ${RING_VAR}/${folder} and ${CAL_DIR}/${folder#sudarshan-}.env stay; databases copied to ${bdir}"
}
fam_once() {   # $1 = the file that keeps the note logged last, $2 = this run's note ("" when all is well):
               # a note is logged once while it holds
    local said=""
    if [[ -z "$2" ]]; then rm -f -- "$1"; return 0; fi
    said="$(cat -- "$1" 2>/dev/null)" || said=""
    if [[ "$2" != "${said}" ]]; then log "$2"; printf '%s\n' "$2" 2>/dev/null > "$1" || true; fi
}
# ---- The price feed's client tokens (cross-design Y3.3; the feed checks them): one per ring client,
# ${FEED_DIR}/<client>, 32 random bytes as urlsafe base64 without padding (43 characters, one line). The
# folder is root:sudarshan 750 and each file root:sudarshan 640, so the feed (user sudarshan) reads them
# all. Made once with system tools on every server, at every run, and never written again: a token that
# is there stays as it is. What is made is not logged; a failure is logged once while it holds. The
# family account cannot read this folder and gets a copy of its own token (fam_provision).
# The first time, all six appear at once (review L1): the feed reads the folder again within a second
# and refuses every client without a file once any file is there, so the folder is filled beside it
# (${FEED_DIR}.new, as a dot file) and renamed into place whole. A single token missing later is made
# on its own, through a file beside it and a hard link.
FEED_CLIENTS=(sudarshan-alerts sudarshan-screener sudarshan-portfolio sudarshan-journal sudarshan-family sudarshan-protect)
feed_token() {   # $1 = a new file (or the empty one mktemp made): a new token in it, root:sudarshan 640.
                 # 0 = written
    local tok
    tok="$(head -c 32 /dev/urandom | base64 -w 0 | tr -- '+/' '-_' | tr -d '=')"
    [[ "${tok}" =~ ^[A-Za-z0-9_-]{43}$ ]] \
        && { printf '%s\n' "${tok}" > "$1" && chmod 640 -- "$1" && chown -- "root:${RING_USER}" "$1"; } 2>/dev/null
}
feed_tokens() (
    set +eEu; trap - ERR
    local name dest tmpf note="" new="${FEED_DIR%/*}/.${FEED_DIR##*/}.new"
    umask 077
    if [[ -L "${FEED_DIR}" ]] || { [[ -e "${FEED_DIR}" ]] && ! cal_dir_ok "${FEED_DIR}"; }; then
        note="WARNING: feed: ${FEED_DIR} is not a folder owned by root and closed to others, so no client token is made there"
    elif [[ ! -e "${FEED_DIR}" ]] && ! cal_dir_ok "${CAL_DIR}"; then
        note="WARNING: feed: ${CAL_DIR} is not a folder owned by root and closed to others, so no client token is made"
    elif [[ ! -e "${FEED_DIR}" ]]; then
        rm -rf -- "${new}" 2>/dev/null   # left by a killed run: this tool holds deploy.lock, so it is stale
        if ! { mkdir -m 750 -- "${new}" && chown -- "root:${RING_USER}" "${new}"; } 2>/dev/null; then
            note="WARNING: feed: ${FEED_DIR} could not be made, so no client token is made"
        else
            for name in "${FEED_CLIENTS[@]}"; do
                feed_token "${new}/${name}" || { note="WARNING: feed: the client tokens in ${FEED_DIR} could not be made"; break; }
            done
            if [[ -z "${note}" ]] && ! mv -T -- "${new}" "${FEED_DIR}" 2>/dev/null; then
                note="WARNING: feed: ${FEED_DIR} could not be put in place, so no client token is made"
            fi
        fi
        rm -rf -- "${new}" 2>/dev/null   # gone after the rename; what a failure left
    else
        find "${FEED_DIR}" -maxdepth 1 -type f -name '.sudarshan-*.??????' -delete 2>/dev/null   # left by a killed run (stale: the lock)
        for name in "${FEED_CLIENTS[@]}"; do
            dest="${FEED_DIR}/${name}"
            if [[ -e "${dest}" || -L "${dest}" ]]; then continue; fi
            tmpf=""
            if tmpf="$(mktemp -p "${FEED_DIR}" ".${name}.XXXXXX" 2>/dev/null)" && feed_token "${tmpf}" \
                    && ln -T -- "${tmpf}" "${dest}" 2>/dev/null; then
                :   # in place; a hard link takes no name another run made meanwhile
            else
                note="WARNING: feed: the client token ${dest} could not be made"
            fi
            if [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
        done
    fi
    fam_once "${STATE}/feed_tokens_note" "${note}"
)
# ---- The family view's account (P6; cross-design Y1-Y3, Y13, Y25). The family service runs as its own
# account, sudarshan-family, which can read none of the owner's secrets: not OpenAlgo's .env, db/ or log/,
# and not /etc/sudarshan (root:sudarshan 750). What it needs is handed to it in ${FAM_DIR}
# (root:sudarshan-family 750, files 640), which the owner's one-time set-up makes
# (sudarshan/ops/family/bootstrap.sh). While that folder exists, and only then, at every run (and once
# more after an install, with the release it brought):
#   - sudarshan, who can read the pepper, is asked for the family's seal keys (python -m
#     sudarshan.family.derive). Root never runs the app's Python (Y2): it checks each line it is handed (a
#     known name, 44 characters of urlsafe base64, nothing else) and writes seal-<name>.key through a
#     temporary file in that folder, renamed into place only when it differs;
#   - store.key (32 random bytes, base64) and the VAPID P-256 key pair (vapid_private.pem; the public key's
#     uncompressed point as urlsafe base64 without padding in vapid_public.txt) are made once by root with
#     system tools (head, base64, openssl) and never written again;
#   - the NSE day files and the family's feed token are copied in when they differ;
#   - python -m sudarshan.family.check runs as sudarshan-family, and provisioned (the family unit's
#     ConditionPathExists) is written only after it passes. After a failure it is removed, the family unit
#     is stopped if it runs, and one notice is recorded for the owner while the failure lasts
#     (family_check_failed).
# A run says nothing unless something changed or failed (each failure once while it holds); the set-up
# (--family-provision) says everything. A failure costs the family view, never an install.
FAM_KEYS=(admin nudge internal portfolio-family journal-family)   # the purposes derive prints, by these names
FAM_MADE=(store.key vapid_private.pem vapid_public.txt feed-token)   # what must be there besides the seal keys
FAM_DAYS=(nse_holidays.txt nse_extra_trading_days.txt)
FAM_EPISODE="${STATE}/family_failing"   # while a failure lasts: the id its notice was recorded under
FAM_SAID="${STATE}/family_said"         # the failure logged last
FAM_TALK=0                              # 1 in --family-provision: every step is said, for the owner
fam_say() { if [[ "${FAM_TALK}" == 1 ]]; then printf 'family: %s\n' "$*"; else log "family: $*"; fi; }
fam_note() {   # $1 = the file that keeps the note logged last, $2 = this run's note: the set-up says it, a run
               # logs it once while it holds
    if [[ "${FAM_TALK}" == 1 ]]; then if [[ -n "$2" ]]; then printf '%s\n' "$2"; fi; return 0; fi
    fam_once "$1" "$2"
}
fam_holds() {   # $1 = a name in FAM_DIR, $2 = a file with what it should hold: 0 when it holds that already,
                # with mode 640 (then nothing is written, and the folder is not touched)
    local dest="${FAM_DIR}/$1"
    [[ -f "${dest}" && ! -L "${dest}" && "$(stat -c %a -- "${dest}" 2>/dev/null)" == "640" ]] && cmp -s -- "$2" "${dest}"
}
fam_place() {   # $1 = a temporary file in FAM_DIR, root's and written whole, $2 = its name there: made
                # root:sudarshan-family 640 and renamed over that name only when its content or mode differ.
                # Prints "written" or "same"; 1 = not put in place (the temporary file is removed)
    local dest="${FAM_DIR}/$2"
    if ! { chmod 640 -- "$1" && chown -- "root:${FAM_USER}" "$1"; } 2>/dev/null; then rm -f -- "$1"; return 1; fi
    if [[ -f "${dest}" && ! -L "${dest}" ]] && cmp -s -- "$1" "${dest}" \
            && [[ "$(stat -c %a -- "${dest}" 2>/dev/null)" == "640" ]]; then
        rm -f -- "$1"; echo same; return 0
    fi
    if mv -fT -- "$1" "${dest}" 2>/dev/null; then echo written; return 0; fi
    rm -f -- "$1"; return 1
}
fam_create() {   # $1 = a temporary file in FAM_DIR, $2 = its name there: root:sudarshan-family 640, put in place
                 # only while nothing has that name (a hard link fails on a taken name). 0 = made
    local rc=1
    if { chmod 640 -- "$1" && chown -- "root:${FAM_USER}" "$1" && ln -T -- "$1" "${FAM_DIR}/$2"; } 2>/dev/null; then rc=0; fi
    rm -f -- "$1"
    return "${rc}"
}
fam_copy() {   # $1 = a plain file in a folder only root can write, $2 = its name in FAM_DIR: copied in when it
               # differs. Prints "written" or "same"; 1 = not copied
    local tmpf
    [[ -f "$1" && ! -L "$1" ]] || return 1
    if fam_holds "$2" "$1"; then echo same; return 0; fi
    tmpf="$(mktemp -p "${FAM_DIR}" ".$2.XXXXXX" 2>/dev/null)" || return 1
    if ! cat -- "$1" 2>/dev/null > "${tmpf}"; then rm -f -- "${tmpf}"; return 1; fi
    fam_place "${tmpf}" "$2"
}
fam_failed() {   # $1 = why (folder, files or check), $2 = what, in words, then lines that go with it (a run logs
                 # them, the set-up has said them): the family view stays off until a check passes, and the owner
                 # is told once while the failure lasts
    local why="$1" what="$2" id said line
    shift 2
    if [[ -e "${FAM_DIR}/provisioned" || -L "${FAM_DIR}/provisioned" ]] && rm -f -- "${FAM_DIR}/provisioned" 2>/dev/null; then
        fam_say "${FAM_DIR}/provisioned removed: the family view cannot start until the check passes again"
    fi
    if [[ -f "${MANAGED}" ]] && grep -qx -- "${FAM_UNIT}" "${MANAGED}" && systemctl is-active --quiet "${FAM_UNIT}" 2>/dev/null; then
        if systemctl stop "${FAM_UNIT}" > /dev/null 2>&1; then fam_say "${FAM_UNIT} stopped: its check failed"; fi
    fi
    said="$(cat -- "${FAM_SAID}" 2>/dev/null)" || said=""
    if [[ "${FAM_TALK}" == 1 || "${said}" != "${why}: ${what}" ]]; then
        fam_say "FAIL: ${what}"
        if [[ "${FAM_TALK}" != 1 ]]; then for line in "$@"; do fam_say "${line}"; done; fi
        printf '%s\n' "${why}: ${what}" 2>/dev/null > "${FAM_SAID}" || true
    fi
    id="$(cat -- "${FAM_EPISODE}" 2>/dev/null)" || id=""
    if [[ ! "${id}" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]]; then   # a new failure: its own id (time and this run's pid)
        id="$(date +%Y%m%d-%H%M%S)-$$"; printf '%s\n' "${id}" 2>/dev/null > "${FAM_EPISODE}" || true
    fi
    notice family_check_failed "deploy-family-check-${id}" why="${why}" what="${what:0:150}"
}
fam_provision() (   # $1 = run or setup. 0 = the check passed and provisioned is in place; 1 = the family view stays
                    # off (a step failed); 2 = there is no ${FAM_DIR} (the set-up has not run): nothing was done
    set +eEu; trap - ERR
    local mode="$1" had=0 out rc r line name tmpf fresh=0 pub work note=""
    local -a lines=() changed=() missing=() fails=() said=()
    local -A keys=()
    if [[ "${mode}" == "setup" ]]; then FAM_TALK=1; fi
    [[ -e "${FAM_DIR}" || -L "${FAM_DIR}" ]] || exit 2
    umask 077
    if ! cal_dir_ok "${FAM_DIR}"; then
        fam_failed folder "${FAM_DIR} is not a folder owned by root and closed to others; run the family set-up again"
        exit 1
    fi
    if [[ -f "${FAM_DIR}/provisioned" ]]; then had=1; fi
    # Left by a run that was killed. Any is stale, whatever its age: every writer here is this tool, which
    # holds deploy.lock (review L3: one kept for ten minutes was a file the check cannot open, so the next
    # run took provisioned away and stopped the family view).
    find "${FAM_DIR}" -maxdepth 1 -type f \( -name '.seal-*.key.??????' -o -name '.store.key.??????' \
        -o -name '.vapid_*.??????' -o -name '.feed-token.??????' -o -name '.nse_*.txt.??????' \
        -o -name '.provisioned.??????' \) -delete 2>/dev/null
    # 1. The seal keys: derived by sudarshan, checked and written by root, which runs none of the app's code.
    out="$(cd -- "${APP_DIR}" && timeout 60 sudo -u "${RING_USER}" -H -- "${APP_DIR}/.venv/bin/python" -m sudarshan.family.derive 2>/dev/null)"; rc=$?
    if [[ ${rc} -ne 0 ]]; then
        note="family: the seal keys could not be derived (exit ${rc}); the keys in place stay"
    else
        mapfile -t lines < <(printf '%s\n' "${out}")
        for line in "${lines[@]}"; do
            if [[ "${line}" =~ ^([a-z-]+)\ ([A-Za-z0-9_-]{43}=)$ ]]; then
                name="${BASH_REMATCH[1]}"
                if [[ " ${FAM_KEYS[*]} " == *" ${name} "* && -z "${keys[${name}]+set}" ]]; then keys[${name}]="${BASH_REMATCH[2]}"; continue; fi
            fi
            keys=(); break   # a line that is not one of ours: nothing of the answer is used
        done
        if [[ ${#keys[@]} -ne ${#FAM_KEYS[@]} ]]; then
            note="family: the derived seal keys were not five known names with a key each; nothing was written, the keys in place stay"
        else
            for name in "${FAM_KEYS[@]}"; do
                # compared through a pipe: a key is never a command's argument, where ps would show it
                if fam_holds "seal-${name}.key" <(printf '%s\n' "${keys[${name}]}"); then continue; fi
                tmpf="$(mktemp -p "${FAM_DIR}" ".seal-${name}.key.XXXXXX" 2>/dev/null)" || { note="family: seal-${name}.key could not be written"; continue; }
                if printf '%s\n' "${keys[${name}]}" 2>/dev/null > "${tmpf}" && r="$(fam_place "${tmpf}" "seal-${name}.key")"; then
                    if [[ "${r}" == "written" ]]; then changed+=("seal-${name}.key"); fi
                else
                    rm -f -- "${tmpf}"; note="family: seal-${name}.key could not be written"
                fi
            done
        fi
    fi
    out=""; keys=()
    fam_note "${STATE}/family_keys_note" "${note}"
    # 2. Made once, never written again: store.key, and the VAPID pair (the public key whenever it is missing).
    if [[ ! -e "${FAM_DIR}/store.key" && ! -L "${FAM_DIR}/store.key" ]]; then
        tmpf="$(mktemp -p "${FAM_DIR}" .store.key.XXXXXX 2>/dev/null)" || tmpf=""
        if [[ -n "${tmpf}" ]] && head -c 32 /dev/urandom 2>/dev/null | base64 2>/dev/null > "${tmpf}" \
                && [[ "$(wc -c < "${tmpf}")" -eq 45 ]] && fam_create "${tmpf}" store.key; then
            changed+=(store.key)
        elif [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
    fi
    if [[ ! -e "${FAM_DIR}/vapid_private.pem" && ! -L "${FAM_DIR}/vapid_private.pem" ]]; then
        tmpf="$(mktemp -p "${FAM_DIR}" .vapid_private.pem.XXXXXX 2>/dev/null)" || tmpf=""
        if [[ -n "${tmpf}" ]] && openssl ecparam -name prime256v1 -genkey -noout -out "${tmpf}" > /dev/null 2>&1 \
                && openssl ec -in "${tmpf}" -noout -check > /dev/null 2>&1 && fam_create "${tmpf}" vapid_private.pem; then
            changed+=(vapid_private.pem); fresh=1
        elif [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
    fi
    if [[ -f "${FAM_DIR}/vapid_private.pem" && ! -L "${FAM_DIR}/vapid_private.pem" ]] \
            && [[ ${fresh} -eq 1 || ! ( -e "${FAM_DIR}/vapid_public.txt" || -L "${FAM_DIR}/vapid_public.txt" ) ]]; then
        pub=""; work="$(mktemp -d 2>/dev/null)" || work=""
        # SubjectPublicKeyInfo of a P-256 key is 91 bytes and ends with the 65-byte uncompressed point (04 x y)
        if [[ -n "${work}" ]] && openssl ec -in "${FAM_DIR}/vapid_private.pem" -pubout -outform DER -out "${work}/pub.der" > /dev/null 2>&1 \
                && [[ "$(wc -c < "${work}/pub.der")" -eq 91 ]]; then
            pub="$(tail -c 65 -- "${work}/pub.der" | base64 -w 0 | tr -- '+/' '-_' | tr -d '=')"
        fi
        if [[ -n "${work}" ]]; then rm -rf -- "${work}"; fi
        tmpf=""
        if [[ "${pub}" =~ ^B[A-P][A-Za-z0-9_-]{85}$ ]] && tmpf="$(mktemp -p "${FAM_DIR}" .vapid_public.txt.XXXXXX 2>/dev/null)" \
                && printf '%s\n' "${pub}" > "${tmpf}" && r="$(fam_place "${tmpf}" vapid_public.txt)"; then
            if [[ "${r}" == "written" ]]; then changed+=(vapid_public.txt); fi
        elif [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
    fi
    # 3. Copies of what the account may read but not reach where it lives: the NSE day files (Y1.3, for the
    #    family's trading calendar; a day file that is gone takes its copy with it) and its own feed token.
    if cal_dir_ok "${CAL_DIR}"; then
        for name in "${FAM_DAYS[@]}"; do
            if [[ -f "${CAL_DIR}/${name}" && ! -L "${CAL_DIR}/${name}" ]]; then
                if r="$(fam_copy "${CAL_DIR}/${name}" "${name}")" && [[ "${r}" == "written" ]]; then changed+=("${name}"); fi
            elif [[ ! -e "${CAL_DIR}/${name}" && ! -L "${CAL_DIR}/${name}" && -f "${FAM_DIR}/${name}" ]]; then
                if rm -f -- "${FAM_DIR}/${name}"; then changed+=("${name} (removed: ${CAL_DIR} has none)"); fi
            fi
        done
    fi
    if cal_dir_ok "${FEED_DIR}" && r="$(fam_copy "${FEED_DIR}/${FAM_USER}" feed-token)" && [[ "${r}" == "written" ]]; then
        changed+=(feed-token)
    fi
    if [[ ${#changed[@]} -gt 0 ]]; then fam_say "written in ${FAM_DIR}: ${changed[*]}"
    elif [[ "${FAM_TALK}" == 1 ]]; then fam_say "nothing to write: every key and copy in ${FAM_DIR} was already in place"; fi
    for name in "${FAM_KEYS[@]}"; do
        if [[ ! -f "${FAM_DIR}/seal-${name}.key" || -L "${FAM_DIR}/seal-${name}.key" ]]; then missing+=("seal-${name}.key"); fi
    done
    for name in "${FAM_MADE[@]}"; do
        if [[ ! -f "${FAM_DIR}/${name}" || -L "${FAM_DIR}/${name}" ]]; then missing+=("${name}"); fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        fam_failed files "the family's keys are not all in ${FAM_DIR} yet (missing: ${missing[*]})"
        exit 1
    fi
    # 4. The check, as the family account itself: what it can and cannot reach. Nothing secret is in its output.
    out="$(cd -- "${APP_DIR}" && timeout 120 sudo -u "${FAM_USER}" -H -- "${APP_DIR}/.venv/bin/python" -m sudarshan.family.check 2>&1)"; rc=$?
    mapfile -t lines < <(printf '%s\n' "${out}" | head -n 60)
    for line in "${lines[@]}"; do
        line="${line//[^ -~]/?}"; line="${line:0:300}"
        [[ -n "${line}" ]] || continue
        said+=("check: ${line}")
        if [[ "${FAM_TALK}" == 1 ]]; then fam_say "check: ${line}"; fi
        if [[ "${line}" == "FAIL "* ]]; then fails+=("${line#FAIL }"); fi
    done
    if [[ ${rc} -ne 0 ]]; then
        if [[ ${#fails[@]} -gt 0 ]]; then
            fam_failed check "${fails[0]}" "${said[@]}"
        else
            fam_failed check "the family check could not run as ${FAM_USER} (exit ${rc}): that account must be able to enter every folder down to ${APP_DIR} and read .venv and sudarshan/ there" "${said[@]:0:10}"
        fi
        exit 1
    fi
    if [[ ${had} -eq 0 ]]; then
        tmpf="$(mktemp -p "${FAM_DIR}" .provisioned.XXXXXX 2>/dev/null)" || tmpf=""
        if [[ -n "${tmpf}" ]] && printf 'the family check passed at %s\n' "$(date '+%F %T %Z')" > "${tmpf}" \
                && fam_create "${tmpf}" provisioned; then
            fam_say "the check passed: ${FAM_DIR}/provisioned written, so the family view may start"
        else
            if [[ -n "${tmpf}" ]]; then rm -f -- "${tmpf}"; fi
            fam_failed files "${FAM_DIR}/provisioned could not be written"
            exit 1
        fi
    elif [[ "${FAM_TALK}" == 1 ]]; then
        fam_say "the check passed; ${FAM_DIR}/provisioned was already there"
    fi
    rm -f -- "${FAM_EPISODE}" "${FAM_SAID}"
    # a family view its check had kept off starts again (a unit that is not installed or not enabled is left alone)
    if [[ ${had} -eq 0 && -f "${MANAGED}" ]] && grep -qx -- "${FAM_UNIT}" "${MANAGED}" \
            && systemctl is-enabled --quiet "${FAM_UNIT}" 2>/dev/null && ! systemctl is-active --quiet "${FAM_UNIT}" 2>/dev/null; then
        if systemctl start "${FAM_UNIT}" > /dev/null 2>&1; then fam_say "${FAM_UNIT} started"; fi
    fi
    if [[ "${FAM_TALK}" == 1 ]]; then
        ngx_check brief   # the family view's nginx lines, one line (they are the owner's to install, and change nothing here)
        fam_say "PASS: the family account is set up, and its check finds it closed off from the owner's secrets"
    fi
    exit 0
)
fam_backup() (   # an install's backup: ${FAM_DIR} into ${bdir}/etc-family (Y1.4); a rollback never puts it back (as R12)
    set +eEu; trap - ERR
    [[ -e "${FAM_DIR}" || -L "${FAM_DIR}" ]] || exit 0
    if cal_dir_ok "${FAM_DIR}" && cp -a -- "${FAM_DIR}" "${bdir}/etc-family" 2>/dev/null; then
        log "family: ${FAM_DIR} copied into the backup (a rollback never puts it back)"
    else
        rm -rf -- "${bdir}/etc-family"; log "WARNING: family: ${FAM_DIR} could not be copied into the backup"
    fi
)
# ---- The family view's nginx lines (P6 O3): three files the owner installs once from sudarshan/ops/nginx
# at the installed release (sudarshan/family/README.md, "Installing the nginx lines"). This tool never writes
# nginx; ngx_check only reads, and says for each file whether it is in place (a plain file of root's that no
# one else can write), this release's (its sha256 is in NGX_SUMS, the owner's cookie name set aside, which
# is compared with OpenAlgo's .env instead) and loaded (`nginx -T` passes and names it); whether the include
# line sits in a server block that listens on 443 (so the guard covers every location of that server) whose
# location / goes to OpenAlgo where the invite page goes; and whether the running nginx was reloaded after
# the files last changed. --nginx-check says each line; the family set-up adds one; a run logs the first
# problem once while it holds, and says nothing while none of the three files is there. `nginx -T` reads
# every site of this nginx: only this server's own lines are looked at, and nothing of it is printed.
NGX_DIR="/etc/nginx"
NGX_BIN="nginx"
NGX_FILES=(conf.d/sudarshan-family-zones.conf snippets/sudarshan-family.conf snippets/sudarshan-family-proxy.conf)
# sha256 of ngx_text of each file above as this release ships it in sudarshan/ops/nginx; the test
# sudarshan/ops/tests/test_deploy_nginx_check.py fails until they agree with those files.
NGX_SUMS=(
    002b48cc7bbaddea5caf015d73248d1fd3080a7113c647dc14cd2caf00f75f83
    4439591ae8c9f30c3976904a9a129e74c7f3cf275509dfc899903bd4fa4de396
    6169cc60889962e492a70a2d28529a922212eea939f95fd4a9bdd14b8438ddc0
)
NGX_OPENALGO="http://127.0.0.1:5000"   # where the invite page goes (snippets/sudarshan-family.conf)
NGX_HOWTO='sudarshan/family/README.md, "Installing the nginx lines"'
ngx_text() {   # $1 = a file: its text, with the name of OpenAlgo's cookie in the map of $sud_owner made OWNER_COOKIE
    awk '/^map \$http_cookie \$sud_owner \{/ { o = 1 }
         o && /=" 1;/ { sub(/\)[A-Za-z0-9_-]+=/, ")OWNER_COOKIE=") }
         o && /^\}/ { o = 0 }
         { print }' "$1"
}
ngx_cookie() {   # $1 = the zones file: the name of OpenAlgo's session cookie its guard knows
    awk '/^map \$http_cookie \$sud_owner \{/ { o = 1 }
         o && /=" 1;/ && match($0, /\)[A-Za-z0-9_-]+=/) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
         o && /^\}/ { o = 0 }' "$1"
}
ngx_env() {   # $1 = a key: its value in OpenAlgo's .env (its last line; quotes and a trailing comment off).
              # 1 = .env cannot be read; 0 with nothing printed = .env does not set it
    local line v
    [[ -f "${ENV_FILE}" && ! -L "${ENV_FILE}" ]] || return 1
    line="$(timeout 5 grep -E "^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=" -- "${ENV_FILE}" 2>/dev/null | tail -n 1)"
    [[ -n "${line}" ]] || return 0
    v="${line#*=}"; v="${v%%#*}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    v="${v#[\"\']}"; v="${v%[\"\']}"
    printf '%s\n' "${v}"
}
ngx_file_ok() {   # 0 = $1 is a plain file owned by the user this tool runs as, writable by no one else
    local st
    [[ -f "$1" && ! -L "$1" ]] && st="$(stat -c '%u %a' -- "$1")" || return 1
    [[ "${st% *}" == "${EUID}" ]] && (( (8#${st#* } & 8#022) == 0 ))
}
ngx_servers() {   # stdin: what `nginx -T` prints. For each server block of a file that is not one of the three:
                  # "server <listens on 443: 1|0> <includes of sudarshan-family.conf> <proxy_pass of its location />
                  # or -> <file>"; and "stray <file>" for such an include outside a server block
    awk '
    function word_end() { if (inw) { words[nw++] = w; w = ""; inw = 0 } }
    function directive(   i) {
        word_end()
        if (nw > 0 && !skip) {
            if (nw >= 2 && words[0] == "include" && words[1] ~ /(^|\/)sudarshan-family\.conf$/) {
                if (insrv && depth == srvdepth) inc++; else print "stray", file
            }
            if (insrv && depth == srvdepth && words[0] == "listen")
                for (i = 1; i < nw; i++) if (words[i] ~ /(^|:)443$/) l443 = 1
            if (insrv && depth == rootdepth && nw >= 2 && words[0] == "proxy_pass") root = words[1]
        }
        nw = 0
    }
    function open_block() {
        word_end(); depth++
        if (!skip && !insrv && nw >= 1 && words[0] == "server") { insrv = 1; srvdepth = depth; inc = 0; l443 = 0; root = "-" }
        else if (insrv && depth == srvdepth + 1 && nw == 2 && words[0] == "location" && words[1] == "/") rootdepth = depth
        nw = 0
    }
    function close_block() {
        word_end(); nw = 0
        if (insrv && depth == srvdepth) { print "server", l443, inc, root, file; insrv = 0 }
        if (depth == rootdepth) rootdepth = -1
        depth--
    }
    /^# configuration file .*:$/ {
        file = substr($0, 22, length($0) - 22)
        depth = 0; insrv = 0; rootdepth = -1; nw = 0; w = ""; inw = 0; q = ""
        skip = (file ~ /\/sudarshan-family(-zones|-proxy)?\.conf$/)
        next
    }
    {
        n = length($0)
        for (i = 1; i <= n; i++) {
            c = substr($0, i, 1)
            if (q != "") {
                if (c == "\\") { w = w substr($0, i + 1, 1); i++ }
                else if (c == q) q = ""
                else w = w c
                continue
            }
            if (c == "#") break
            if (c == " " || c == "\t" || c == "\r") { word_end(); continue }
            if (c == "\"" || c == "\047") { word_end(); q = c; inw = 1; continue }
            if (c == ";") { directive(); continue }
            if (c == "{") { open_block(); continue }
            if (c == "}") { close_block(); continue }
            w = w c; inw = 1
        }
        if (q != "") w = w "\n"; else word_end()
    }'
}
ngx_loaded_at() {   # when the running nginx last loaded its configuration (an epoch second): the start of its
                    # oldest worker that is not shutting down. Nothing when nginx is not running
    local now oldest="" e rest
    now="$(date +%s)"
    while read -r e rest; do
        [[ "${rest}" == "nginx: worker process" && "${e}" =~ ^[0-9]+$ ]] || continue
        if [[ -z "${oldest}" || ${e} -gt ${oldest} ]]; then oldest="${e}"; fi
    done < <(ps -C nginx -o etimes=,args= 2>/dev/null)
    if [[ -n "${oldest}" ]]; then echo $(( now - oldest )); fi
}
ngx_check() (   # $1 = report (every line; 0 = all holds, 1 = not), run (the first problem logged once while it
                # holds) or brief (one line, for the family set-up)
    set +eEu; trap - ERR
    local mode="$1" i f path have=0 dump="" errf rc kind l443 inc root file site="" at newest m name want host
    local -a lines=() recs=() good=() bad=() stray=()
    say() { lines+=("$1 $2"); }
    for f in "${NGX_FILES[@]}"; do if [[ -e "${NGX_DIR}/${f}" || -L "${NGX_DIR}/${f}" ]]; then have=1; fi; done
    if [[ ${have} -eq 0 ]]; then
        case "${mode}" in
            run) fam_once "${STATE}/family_nginx_note" "" ;;
            brief) echo "family: nginx: the family view's nginx lines are not installed yet (${NGX_HOWTO})" ;;
            report) echo "nginx: FAIL none of the family view's nginx files is in ${NGX_DIR}: install them (${NGX_HOWTO})" ;;
        esac
        exit 1
    fi
    if ! command -v "${NGX_BIN}" > /dev/null 2>&1; then
        say FAIL "nginx is not installed on this server, so nothing of these files can be loaded"
    else
        errf="$(mktemp)"; dump="$(timeout 30 "${NGX_BIN}" -T 2>"${errf}")"; rc=$?; rm -f -- "${errf}"
        if [[ ${rc} -ne 0 ]]; then
            dump=""; say FAIL "nginx's configuration does not pass its own test, so no change of it can be loaded: run sudo nginx -t to see why"
        fi
    fi
    for i in "${!NGX_FILES[@]}"; do
        f="${NGX_FILES[$i]}"; path="${NGX_DIR}/${f}"
        if [[ ! -e "${path}" && ! -L "${path}" ]]; then say FAIL "${path} is missing: install the files again (${NGX_HOWTO})"; continue; fi
        if ! ngx_file_ok "${path}"; then say FAIL "${path} is not a plain file of root's that only root can write: install the files again"; continue; fi
        if [[ "$(ngx_text "${path}" | sha256sum | cut -c1-64)" != "${NGX_SUMS[$i]}" ]]; then
            say FAIL "${path} is not this release's copy (an older release's, or changed by hand): install the files again (${NGX_HOWTO})"; continue
        fi
        if [[ -n "${dump}" ]] && ! grep -qxF -- "# configuration file ${path}:" <<< "${dump}"; then
            if [[ ${i} -eq 0 ]]; then say FAIL "nginx does not load ${path}: nginx.conf must include conf.d/*.conf inside http, as Ubuntu's does"
            else say FAIL "nginx does not load ${path}: add the include line to the server block for port 443 (${NGX_HOWTO})"; fi
            continue
        fi
        say PASS "${path}: in place and this release's${dump:+, loaded by nginx}"
    done
    if [[ -n "${dump}" ]]; then
        mapfile -t recs < <(printf '%s\n' "${dump}" | ngx_servers)
        for f in "${recs[@]}"; do
            if [[ "${f}" == "stray "* ]]; then stray+=("${f#stray }"); continue; fi
            read -r kind l443 inc root file <<< "${f}"
            [[ "${kind}" == "server" && "${inc}" =~ ^[0-9]+$ && ${inc} -gt 0 ]] || continue
            if [[ "${l443}" == 1 ]]; then good+=("${root} ${file}"); else bad+=("${file}"); fi
        done
        if [[ ${#stray[@]} -gt 0 ]]; then
            say FAIL "snippets/sudarshan-family.conf is included outside a server block (${stray[0]}): put the line inside the server block for port 443"
        elif [[ ${#bad[@]} -gt 0 ]]; then
            say FAIL "snippets/sudarshan-family.conf is included in a server block that does not listen on port 443 (${bad[0]}): move the line into the server block for port 443"
        elif [[ ${#good[@]} -eq 0 ]]; then
            say FAIL "no server block includes snippets/sudarshan-family.conf: add the include line to the server block for port 443 (${NGX_HOWTO})"
        else
            root="${good[0]%% *}"; site="${good[0]#* }"
            say PASS "the guard sits in the server block for port 443 of ${site}, so it covers every location there"
            if [[ "${root%/}" == "${NGX_OPENALGO}" ]]; then
                say PASS "the invite page goes to OpenAlgo at ${NGX_OPENALGO#http://}, as location / of that server does"
            elif [[ "${root}" == "-" ]]; then
                say FAIL "where location / of that server sends pages could not be read, so the invite page's address (${NGX_OPENALGO#http://}) could not be compared with it"
            else
                say FAIL "location / of that server goes to ${root}, but the invite page goes to ${NGX_OPENALGO}: invite links will not open until the two agree"
            fi
        fi
    fi
    path="${NGX_DIR}/${NGX_FILES[0]}"
    if ngx_file_ok "${path}"; then
        name="$(ngx_cookie "${path}")"
        if want="$(ngx_env SESSION_COOKIE_NAME)" && host="$(ngx_env HOST_SERVER)"; then
            want="${want:-session}"
            if [[ "${host}" == https://* ]]; then want="__Secure-${want}"; fi
            if [[ -n "${name}" && "${name}" == "${want}" ]]; then
                say PASS "the guard knows OpenAlgo's session cookie, ${name}, as OpenAlgo's .env makes it"
            else
                say FAIL "the guard knows OpenAlgo's session cookie as ${name:-nothing}, but OpenAlgo's .env makes it ${want}: put ${want} in its place in ${path} (under map \$http_cookie \$sud_owner), then reload nginx"
            fi
        else
            say FAIL "OpenAlgo's .env could not be read, so the cookie the guard knows could not be compared with it"
        fi
    fi
    if [[ -n "${dump}" ]]; then
        at="$(ngx_loaded_at)"
        if [[ -z "${at}" ]]; then
            say FAIL "nginx is not running"
        else
            newest=0
            for f in "${NGX_FILES[@]/#/${NGX_DIR}/}" ${site:+"${site}"}; do
                m="$(stat -L -c %Y -- "${f}" 2>/dev/null)" || continue
                if [[ "${m}" =~ ^[0-9]+$ && ${m} -gt ${newest} ]]; then newest="${m}"; fi
            done
            if (( newest > at + 1 )); then
                say FAIL "nginx has not loaded these files since they last changed: run sudo nginx -t && sudo systemctl reload nginx"
            else
                say PASS "the running nginx has loaded them (it was reloaded after they last changed)"
            fi
        fi
    fi
    local first=""
    for f in "${lines[@]}"; do if [[ "${f}" == "FAIL "* ]]; then first="${f#FAIL }"; break; fi; done
    case "${mode}" in
        report)
            for f in "${lines[@]}"; do echo "nginx: ${f}"; done
            if [[ -z "${first}" ]]; then echo "nginx: PASS. The family view's nginx lines are installed, loaded and this release's."; exit 0; fi
            echo "nginx: FAIL. Nothing was changed; each FAIL line above says what to do."; exit 1 ;;
        run) fam_once "${STATE}/family_nginx_note" "${first:+family: nginx: ${first} (sudarshan-deploy --nginx-check says more)}" ;;
        brief)
            if [[ -z "${first}" ]]; then echo "family: nginx: the family view's nginx lines are installed, loaded and this release's"
            else echo "family: nginx: ${first}"; fi ;;
    esac
    [[ -z "${first}" ]]
)
