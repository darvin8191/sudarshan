        elif [[ ${got} -ne 0 ]]; then echo "calendar: could not fetch the list of ${tag}"
        elif ! cal_sync check "${ck}/nse-calendar.conf" "${CAL_DIR}" "${ck}" "$(cal_today)"; then echo "calendar: the list of ${tag} could not be checked"; fi
    fi
