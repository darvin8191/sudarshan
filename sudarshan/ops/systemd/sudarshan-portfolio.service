# सुदर्शन / SUDARSHAN portfolio (M7): the Upstox tab and the owner's own portfolio tabs.
# Its sealed local API answers OpenAlgo's bridge on 127.0.0.1:5583 (loopback only); GET /health there
# says which release is installed and what the service is doing. The service is off until the release
# turns SUDARSHAN_PORTFOLIO on in OpenAlgo's .env (ops/deploy/openalgo-env.conf); off, it answers every
# request as off, opens no database and runs no job.
# Docs: sudarshan/portfolio/README.md. Optional settings: /etc/sudarshan/portfolio.env (root:sudarshan 640).
# Installed, enabled and restarted by sudarshan-deploy from each release, like sudarshan-feed.

[Unit]
Description=SUDARSHAN portfolio (Upstox tab and the owner's portfolios)
After=network-online.target
Wants=network-online.target
# Ordering only, as for the alerts: no Wants= on OpenAlgo, which would start it while the deploy
# tool has it stopped. It reads OpenAlgo's .env for the switch and the pepper at start.
After=openalgo.service

[Service]
Type=simple
User=sudarshan
Group=sudarshan
Slice=sudarshan.slice
WorkingDirectory=/opt/sudarshan/apps/openalgo
ExecStart=/opt/sudarshan/apps/openalgo/.venv/bin/python -m sudarshan.portfolio
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/sudarshan/portfolio.env
# The only place it writes: /var/lib/sudarshan-portfolio (portfolio.db and its journal).
# openalgo.db is read without write access, so db/ stays read-only here.
StateDirectory=sudarshan-portfolio
StateDirectoryMode=0700
# Restarted after a crash, every 10 s. Not after exit status 2 (a setting or key it cannot use):
# that would only repeat the same error line. A taken port is not a crash: it waits and tries again.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
# SIGTERM: the jobs are cancelled, the listener closes and the store is closed; killed after 20 s.
TimeoutStopSec=20
# Squeezed before it is killed (about 75% of MemoryMax), and behind TRINETRA when the box is busy.
MemoryHigh=192M
MemoryMax=256M
CPUWeight=40
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=-/etc/sudarshan
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# No IPAddressDeny: later parts reach api.upstox.com and portal.amfiindia.com (the token and the
# NAV file), which the alerts unit's loopback-only policy would refuse.

[Install]
WantedBy=multi-user.target
