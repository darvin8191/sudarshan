{
  "schema": 1,
  "note": "Hand-computed golden vectors for options.py (EN5). Prices and strikes are paise, open interest whole contracts, an implied volatility a float in the feed's unit. A ratio is an exact fraction in percent units written as text; a float is a JSON number with a point; an object with 'why' is a Why. In a build-up vector 'price' and 'oi' are [reference, now].",

  "buildup": [
    {"id": "O1", "note": "price +0.5%, OI +2.0% over the day", "price": [20000, 20100], "oi": [100000, 102000], "expect": "long_buildup"},
    {"id": "O2a", "note": "price -0.5%, OI +2.0%", "price": [20000, 19900], "oi": [100000, 102000], "expect": "short_buildup"},
    {"id": "O2b", "note": "price +0.5%, OI -1%", "price": [20000, 20100], "oi": [100000, 99000], "expect": "short_covering"},
    {"id": "O2c", "note": "price -0.5%, OI -1%", "price": [20000, 19900], "oi": [100000, 99000], "expect": "long_unwinding"},
    {"id": "O3", "note": "price unchanged, OI +3%", "price": [20000, 20000], "oi": [100000, 103000], "expect": "none"},
    {"id": "O3b", "note": "price up, OI unchanged", "price": [20000, 20100], "oi": [100000, 100000], "expect": "none"},
    {"id": "O3c", "note": "nothing moved", "price": [20000, 20000], "oi": [100000, 100000], "expect": "none"},
    {"id": "T1", "note": "a move of exactly the threshold counts", "price": [20000, 20100], "oi": [100000, 102000], "min_price": "0.5", "min_oi": "2", "expect": "long_buildup"},
    {"id": "T2", "note": "a paisa under the price threshold: 0.495%", "price": [20000, 20099], "oi": [100000, 102000], "min_price": "0.5", "expect": "none"},
    {"id": "T3", "note": "OI +1.99% is under a threshold of 2%", "price": [20000, 20100], "oi": [100000, 101990], "min_oi": "2", "expect": "none"},
    {"id": "T4", "note": "a fall of exactly the threshold counts", "price": [20000, 19900], "oi": [100000, 102000], "min_price": "0.5", "expect": "short_buildup"},
    {"id": "T5", "note": "a reference of zero needs no division", "price": [0, 100], "oi": [0, 10], "min_price": "1", "min_oi": "1", "expect": "long_buildup"},
    {"id": "T6", "note": "large open interest, exactly +2%", "price": [20000, 20100], "oi": [12345600, 12592512], "min_oi": "2", "expect": "long_buildup"},
    {"id": "T7", "note": "large open interest, one contract under +2%", "price": [20000, 20100], "oi": [12345600, 12592511], "min_oi": "2", "expect": "none"}
  ],

  "oi_change": [
    {"id": "C1", "oi": [100000, 102000], "expect": "2"},
    {"id": "C2", "oi": [100000, 99000], "expect": "-1"},
    {"id": "C3", "note": "nothing to compare with", "oi": [0, 5], "expect": {"why": "zero", "detail": []}},
    {"id": "C4", "note": "no reference", "oi": [null, 5], "expect": {"why": "no_data", "detail": ["oi"]}},
    {"id": "C5", "oi": [100000, 100000], "expect": "0"}
  ],

  "atm": [
    {"id": "O6", "note": "spot exactly between two strikes takes the lower", "spot": 2587500, "strikes": [2585000, 2590000], "expect": 2585000},
    {"id": "A2", "note": "a paisa above the middle", "spot": 2587501, "strikes": [2585000, 2590000], "expect": 2590000},
    {"id": "A3", "note": "a paisa below the middle", "spot": 2587499, "strikes": [2585000, 2590000], "expect": 2585000},
    {"id": "A4", "note": "below every strike", "spot": 100, "strikes": [2585000, 2590000], "expect": 2585000},
    {"id": "A5", "note": "above every strike", "spot": 9999999, "strikes": [2585000, 2590000], "expect": 2590000},
    {"id": "A6", "note": "on a strike", "spot": 2590000, "strikes": [2585000, 2590000, 2595000], "expect": 2590000},
    {"id": "A7", "note": "no spot yet", "spot": null, "strikes": [2585000, 2590000], "expect": {"why": "no_data", "detail": ["spot"]}},
    {"id": "A8", "note": "no strikes followed", "spot": 2587500, "strikes": [], "expect": {"why": "no_options", "detail": ["NIFTY"]}}
  ],

  "pcr": [
    {"id": "O4", "note": "PE 1,200,000 over CE 1,000,000", "strikes": [
      {"strike": 2585000, "ce_oi": 400000, "pe_oi": 500000},
      {"strike": 2590000, "ce_oi": 300000, "pe_oi": 400000},
      {"strike": 2595000, "ce_oi": 300000, "pe_oi": 300000}], "expect": "6/5"},
    {"id": "O4b", "note": "one more put contract", "strikes": [
      {"strike": 2585000, "ce_oi": 400000, "pe_oi": 500000},
      {"strike": 2590000, "ce_oi": 300000, "pe_oi": 400000},
      {"strike": 2595000, "ce_oi": 300000, "pe_oi": 300001}], "expect": "1200001/1000000"},
    {"id": "P3", "note": "a strike that does not report both sides is left out of both sums", "strikes": [
      {"strike": 2585000, "ce_oi": 400000, "pe_oi": 500000},
      {"strike": 2590000, "ce_oi": 900000, "pe_oi": null},
      {"strike": 2595000, "ce_oi": null, "pe_oi": 900000}], "expect": "5/4"},
    {"id": "P4", "note": "no calls at all", "strikes": [
      {"strike": 2585000, "ce_oi": 0, "pe_oi": 500000}], "expect": {"why": "zero", "detail": []}},
    {"id": "P5", "note": "no open interest followed", "strikes": [
      {"strike": 2585000}], "expect": {"why": "no_data", "detail": ["oi"]}},
    {"id": "P6", "note": "no puts is a ratio of zero", "strikes": [
      {"strike": 2585000, "ce_oi": 500, "pe_oi": 0}], "expect": "0"}
  ],

  "max_pain": [
    {"id": "O5", "note": "strikes 100/110/120, CE OI 10/20/30, PE OI 30/20/10: pain 400, 200, 400", "strikes": [
      {"strike": 10000, "ce_oi": 10, "pe_oi": 30},
      {"strike": 11000, "ce_oi": 20, "pe_oi": 20},
      {"strike": 12000, "ce_oi": 30, "pe_oi": 10}], "expect": 11000},
    {"id": "M2", "note": "two strikes with the same pain: the lower", "strikes": [
      {"strike": 10000, "ce_oi": 10, "pe_oi": 10},
      {"strike": 11000, "ce_oi": 10, "pe_oi": 10}], "expect": 10000},
    {"id": "M3", "note": "all the writing is at the top strike", "strikes": [
      {"strike": 10000, "ce_oi": 0, "pe_oi": 0},
      {"strike": 11000, "ce_oi": 0, "pe_oi": 0},
      {"strike": 12000, "ce_oi": 0, "pe_oi": 100}], "expect": 12000},
    {"id": "M4", "note": "a strike without both sides is not a candidate", "strikes": [
      {"strike": 10000, "ce_oi": 10, "pe_oi": 30},
      {"strike": 11000, "ce_oi": 20, "pe_oi": null},
      {"strike": 12000, "ce_oi": 30, "pe_oi": 10}], "expect": 10000},
    {"id": "M5", "note": "no open interest followed", "strikes": [{"strike": 10000}], "expect": {"why": "no_data", "detail": ["oi"]}}
  ],

  "atm_iv": [
    {"id": "V1", "note": "the mean of the ATM call and put", "spot": 2587500, "strikes": [
      {"strike": 2585000, "ce_iv": 12.0, "pe_iv": 13.0, "ce_ltp": 15000, "pe_ltp": 13000},
