      "followed": {
        "run": {"on": "close", "tf": 15},
        "line": "F&O stock futures · 15-min",
        "plan": {
          "on": "close", "tf": 15, "need": {"15": 1}, "instances": [], "uses": ["oi"],
          "ids": ["c1", "c2"], "rank_order": "asc"
        }
      }
    },
    {
      "key": "iv_extremes",
      "name": "IV extremes",
      "about": "NIFTY 50 and NIFTY BANK when implied volatility is at its 80th percentile or higher, or at its 20th or lower. India VIX itself is not checked.",
      "line": "Indices · after the close",
      "columns": ["ltp", "change_pct", "value"],
      "screen": {
        "universe": {"kind": "indices"},
        "run": {"on": "after_close"},
        "where": {
          "any": [
            {
              "id": "c1", "on": true,
              "left": {"opt": "iv_pct", "underlying": "self"},
              "op": "gte", "right": {"num": "80"}
            },
            {
              "id": "c2", "on": true,
              "left": {"opt": "iv_pct", "underlying": "self"},
              "op": "lte", "right": {"num": "20"}
            }
          ]
        },
        "rank": {"by": {"opt": "iv_pct", "underlying": "self"}, "order": "desc"}
      },
      "plan": {
        "on": "after_close", "tf": "D", "need": {}, "instances": [], "uses": ["options"],
        "ids": ["c1", "c2"], "rank_order": "desc"
      }
    },
    {
      "key": "orb_breakout",
      "name": "ORB breakout",
      "about": "Stocks whose 5-min close crosses above the high of the first 15 minutes, on volume above 1.5 times its 20-candle average. Nothing shows before 09:30, when that range is complete.",
      "line": "F&O stocks · 5-min",
      "screen": {
        "universe": {"kind": "fno_stocks"},
        "run": {"on": "close", "tf": 5},
        "where": {
          "all": [
            {
              "id": "c1", "on": true,
              "left": {"field": "close", "tf": 5, "at": 0},
              "op": "crosses_above",
              "right": {"ind": "orb_high", "p": {"minutes": 15}, "out": "value", "tf": 5, "at": 0}
            },
            {
              "id": "c2", "on": true,
              "left": {"field": "volume", "tf": 5, "at": 0},
              "op": "gt",
              "right": {
                "math": "mul",
                "args": [
                  {"ind": "sma", "p": {"length": 20, "source": "volume"}, "out": "value", "tf": 5, "at": 0},
                  {"num": "1.5"}
                ]
              }
            }
          ]
        }
      },
      "plan": {
        "on": "close", "tf": 5, "need": {"5": 20, "D": 1},
        "instances": [["sma", {"length": 20, "source": "volume"}, 5]], "uses": [],
        "ids": ["c1", "c2"], "rank_order": "desc"
      }
    },
    {
      "key": "ema_cross_15",
      "name": "15-min EMA cross",
      "about": "Stocks where the 15-min EMA 20 crosses above EMA 50 while RSI 14 is above 50 and the price is above VWAP.",
      "line": "F&O stocks · 15-min",
      "screen": {
        "universe": {"kind": "fno_stocks"},
        "run": {"on": "close", "tf": 15},
        "where": {
          "all": [
            {
              "id": "c1", "on": true,
              "left": {"ind": "ema", "p": {"length": 20, "source": "close"}, "out": "value", "tf": 15, "at": 0},
              "op": "crosses_above",
              "right": {"ind": "ema", "p": {"length": 50, "source": "close"}, "out": "value", "tf": 15, "at": 0}
            },
            {
              "id": "c2", "on": true,
              "left": {"ind": "rsi", "p": {"length": 14}, "out": "value", "tf": 15, "at": 0},
              "op": "gt", "right": {"num": "50"}
            },
            {
              "id": "c3", "on": true,
              "left": {"field": "close", "tf": 15, "at": 0},
              "op": "gt", "right": {"field": "vwap", "tf": 15, "at": 0}
            }
          ]
        }
      },
      "plan": {
        "on": "close", "tf": 15, "need": {"15": 151, "D": 1},
        "instances": [
          ["ema", {"length": 20, "source": "close"}, 15],
          ["ema", {"length": 50, "source": "close"}, 15],
          ["rsi", {"length": 14}, 15]
        ],
        "uses": [], "ids": ["c1", "c2", "c3"], "rank_order": "desc"
      }
    },
