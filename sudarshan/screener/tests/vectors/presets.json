{
  "note": "The library's presets as the owner reads them. Typed from design 5.3, never produced by the code: the checked form of each screen, the words on its card, and what the engine is told to keep (history per timeframe, indicators, extra data). Every preset stores these defaults beside the lines below.",
  "defaults": {
    "target": {
      "list_id": null,
      "grace": {"mode": "runs", "n": 2},
      "max_adds_per_run": 10
    },
    "alerts": {
      "on": true,
      "min_matches": 1,
      "unique_per_day": true,
      "skip_zero": true,
      "tell_exits": false,
      "after_trigger": "continue",
      "cooldown_runs": 0,
      "max_per_day_per_symbol": 3,
      "channels": null,
      "columns": ["ltp", "change_pct"]
    },
    "rank": {
      "by": {"field": "change_pct", "tf": "D", "at": 0},
      "order": "desc"
    }
  },
  "presets": [
    {
      "key": "long_buildup",
      "name": "Long build-up",
      "about": "Stock futures with the price up and open interest up 2% or more since yesterday's close.",
      "line": "F&O stock futures · after the close",
      "columns": ["ltp", "change_pct", "value"],
      "screen": {
        "universe": {"kind": "fno_futures"},
        "run": {"on": "after_close"},
        "where": {
          "all": [
            {
              "id": "c1", "on": true,
              "left": {"oi": "buildup", "window": {"kind": "day"}, "min_price_pct": "0", "min_oi_pct": "0"},
              "op": "is", "args": {"name": "long_buildup"}
            },
            {
              "id": "c2", "on": true,
              "left": {"oi": "oi_change_pct", "window": {"kind": "day"}},
              "op": "gte", "right": {"num": "2"}
            }
          ]
        },
        "rank": {"by": {"oi": "oi_change_pct", "window": {"kind": "day"}}, "order": "desc"}
      },
      "plan": {
        "on": "after_close", "tf": "D", "need": {"D": 1}, "instances": [], "uses": ["oi"],
        "ids": ["c1", "c2"], "rank_order": "desc"
      },
      "followed": {
        "run": {"on": "close", "tf": 15},
        "line": "F&O stock futures · 15-min",
        "plan": {
          "on": "close", "tf": 15, "need": {"15": 1}, "instances": [], "uses": ["oi"],
          "ids": ["c1", "c2"], "rank_order": "desc"
        }
      }
    },
    {
      "key": "short_buildup",
      "name": "Short build-up",
