    {
      "key": "volume_spike",
      "name": "Volume spike",
      "about": "NIFTY 500 stocks whose volume for the day is at least twice its 20-day average and that closed above the previous close. Checked after the close.",
      "line": "NIFTY 500 · after the close",
      "columns": ["ltp", "change_pct", "value"],
      "screen": {
