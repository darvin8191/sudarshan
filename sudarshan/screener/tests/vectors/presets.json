    {
      "key": "orb_breakout",
      "name": "ORB breakout",
      "about": "Stocks whose 5-min close crosses above the high of the first 15 minutes, on volume above 1.5 times its 20-candle average. Nothing shows before 09:30, when that range is complete.",
      "line": "F&O stocks · 5-min",
      "screen": {
        "universe": {"kind": "fno_stocks"},
        "run": {"on": "close", "tf": 5},
        "where": {
          "all": [
            {
              "id": "c1", "on": true,
              "left": {"field": "close", "tf": 5, "at": 0},
              "op": "crosses_above",
              "right": {"ind": "orb_high", "p": {"minutes": 15}, "out": "value", "tf": 5, "at": 0}
            },
            {
              "id": "c2", "on": true,
              "left": {"field": "volume", "tf": 5, "at": 0},
              "op": "gt",
              "right": {
                "math": "mul",
                "args": [
                  {"ind": "sma", "p": {"length": 20, "source": "volume"}, "out": "value", "tf": 5, "at": 0},
                  {"num": "1.5"}
                ]
              }
            }
          ]
        }
      },
      "plan": {
        "on": "close", "tf": 5, "need": {"5": 20, "D": 1},
        "instances": [["sma", {"length": 20, "source": "volume"}, 5]], "uses": [],
        "ids": ["c1", "c2"], "rank_order": "desc"
      }
    },
